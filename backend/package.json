{
  "name": "chopdot-api",
  "version": "1.0.0",
  "description": "ChopDot Backend API Server",
  "main": "dist/index.js",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:p025:database": "DATABASE_URL=\"$P025_DATABASE_URL\" tsx src/integration/p025-actor-boundary.database.ts",
    "test:p025:migrations": "DATABASE_URL=\"$P025_DATABASE_URL\" tsx src/integration/p025-migration-chain.database.ts",
    "test:p025:migrated-database": "npm run test:p025:migrations && npm run test:p025:database",
    "type-check": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:pull": "prisma db pull"
  },
  "keywords": [
    "chopdot",
    "api",
    "express"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "pg": "^8.22.0",
    "prisma": "^7.7.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.4",
    "supertest": "^7.2.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.4"
  }
}
