{
  "id": "chopdot-agent-core-adversarial-v1",
  "version": "1.0.0",
  "cases": [
    {
      "id": "product-definition-rejects-universal-actor",
      "kind": "benchmark_packet_validation",
      "packet_type": "product-definition",
      "expected_valid": false,
      "expected_issue_code": "action_scope_universal",
      "input": {
        "packet_type": "ProductDefinitionPacketV1",
        "user_state": "one group state",
        "one_next_action": "Continue",
        "action_scope": {
          "actor": "everyone",
          "state": "one group state",
          "route": "home",
          "universal": false
        }
      }
    },
    {
      "id": "ux-rejects-wrong-layer-order",
      "kind": "benchmark_packet_validation",
      "packet_type": "ux-journey",
      "expected_valid": false,
      "expected_issue_code": "layer_order_invalid",
      "input": {
        "packet_type": "UxJourneyPacketV1",
        "layer_order": [
          "chopdot-differentiation",
          "category-baseline",
          "bounded-experiments"
        ],
        "user_state": "one invitation state",
        "one_next_action": "Review invitation",
        "action_scope": {
          "actor": "invited participant",
          "state": "one pending invitation",
          "route": "invitation",
          "universal": false
        }
      }
    },
    {
      "id": "product-profile-requires-outcome",
      "kind": "profile_validation",
      "expected_valid": false,
      "input": {
        "profile_id": "product-definition",
        "artifact_contract": {},
        "evaluator": {},
        "budgets": {},
        "terminal_states": []
      }
    },
    {
      "id": "ux-profile-requires-evaluator",
      "kind": "profile_validation",
      "expected_valid": false,
      "input": {
        "profile_id": "ux-creation",
        "artifact_contract": {},
        "expected_outcome": {},
        "budgets": {},
        "terminal_states": []
      }
    },
    {
      "id": "routing-rejects-universal-receipt-first-action",
      "kind": "task_routing",
      "expected_verdict": "blocked",
      "input": { "taskDomain": "product-definition", "expectedOutcome": "Define one bounded product decision with evidence.", "inPaths": ["product"], "outPaths": ["src"], "failureSignals": ["universal-product-action"] }
    },
    {
      "id": "routing-rejects-contributor-as-required-authority",
      "kind": "task_routing",
      "expected_verdict": "blocked",
      "input": { "taskDomain": "security-authority", "expectedOutcome": "Preserve contributor and project authority separation.", "inPaths": ["governance"], "outPaths": ["src"], "failureSignals": ["named-contributor-required"] }
    },
    {
      "id": "routing-does-not-confuse-kg-transport-with-context",
      "kind": "task_routing",
      "expected_verdict": "unverified",
      "input": { "taskDomain": "research", "expectedOutcome": "Return populated cited context for the exact root.", "inPaths": ["docs"], "contextTransportOk": true, "contextFactCount": 0 }
    },
    {
      "id": "routing-rejects-disabled-skill-acceptance",
      "kind": "task_routing",
      "expected_verdict": "blocked",
      "input": { "taskDomain": "implementation", "expectedOutcome": "Implement with repository-approved methods only.", "inPaths": ["scripts"], "outPaths": ["src"], "skillIds": ["skill-chopdot-engineering-judgment"] }
    },
    {
      "id": "routing-requires-host-parser-proof",
      "kind": "task_routing",
      "expected_verdict": "routed",
      "input": { "taskDomain": "incident", "expectedOutcome": "Repair the hosted workflow parser failure at exact head.", "inPaths": [".github/workflows"], "outPaths": ["src"], "hostParserRequired": true, "requestedMutation": false }
    },
    {
      "id": "routing-rejects-governance-without-visible-product-checkpoint",
      "kind": "task_routing",
      "expected_verdict": "blocked",
      "input": { "taskDomain": "ux", "expectedOutcome": "Show a visible product checkpoint before governance acceptance.", "inPaths": ["src"], "outPaths": ["governance"], "userFacing": true, "failureSignals": ["missing-visible-product-checkpoint"] }
    },
    {
      "id": "route-contract-roundtrip-binds-task-scope",
      "kind": "route_contract_roundtrip",
      "expected_valid": true,
      "input": {
        "taskDomain": "implementation",
        "expectedOutcome": "Bind the exact task path scope through canonical route and contract persistence.",
        "inPaths": ["docs/agent-system", "product/context-authority.json", "scripts/agent-system"],
        "outPaths": ["src"]
      }
    },
    {
      "id": "route-contract-roundtrip-retains-profile-checks",
      "kind": "route_contract_roundtrip",
      "expected_valid": true,
      "input": {
        "taskDomain": "implementation",
        "expectedOutcome": "Retain profile-required deterministic checks when no custom command is supplied.",
        "inPaths": ["scripts/agent-system"],
        "outPaths": ["PRODUCT_TRUTH.md", "src"]
      }
    }
  ]
}
