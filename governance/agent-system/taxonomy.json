  "terminalStates": [
    {
      "id": "succeeded",
      "success": true,
      "requiredEvidence": [
        "accepted evaluation",
        "artifact hashes",
        "required environment readback",
        "reconciled effects",
        "final source status"
      ]
    },
    {
      "id": "failed_verification",
      "success": false,
      "requiredEvidence": [
        "failed assertions",
        "commands and counts",
        "repair history"
      ]
    },
    {
      "id": "blocked",
      "success": false,
      "requiredEvidence": [
        "blocker identity",
        "checks exhausted",
        "safe next action"
      ]
    },
    {
      "id": "approval_required",
      "success": false,
      "requiredEvidence": [
        "proposed effect",
        "target and impact",
        "required approver",
        "rollback and readback plan"
      ]
    },
    {
      "id": "budget_exhausted",
      "success": false,
      "requiredEvidence": [
        "budget consumption",
        "best known state",
        "remaining gap"
      ]
    },
    {
      "id": "cancelled",
      "success": false,
      "requiredEvidence": [
        "actor",
        "reason",
        "effect reconciliation status"
      ]
    }
  ],
  "evidenceLevels": [
    {
      "id": "source-only",
      "rank": 0,
      "promotable": true,
      "meaning": "Implementation or documentation exists; no execution proof."
    },
    {
      "id": "unit",
      "rank": 1,
      "promotable": true,
      "meaning": "Focused deterministic or automated test executed."
    },
    {
      "id": "simulated-integration",
      "rank": 2,
      "promotable": true,
      "meaning": "Integrated flow executed against local or simulated dependencies."
    },
    {
      "id": "simulated-host",
      "rank": 3,
      "promotable": true,
      "meaning": "Flow executed inside a host simulator; not real-host proof."
    },
    {
      "id": "exact-candidate",
      "rank": 4,
      "promotable": true,
      "meaning": "Checks executed against the exact clean candidate commit, tree, and dependency locks."
    },
    {
      "id": "real-host-chain",
      "rank": 5,
      "promotable": true,
      "meaning": "Flow executed on the named real host, network, or chain with exact provenance and required finality."
    },
    {
      "id": "live-user",
      "rank": 6,
      "promotable": true,
      "meaning": "Observed participant journey with consent and redacted evidence."
    },
    {
      "id": "release",
      "rank": 7,
      "promotable": true,
      "meaning": "Published artifact is cryptographically tied to the exact candidate and deployment record."
    },
    {
      "id": "local-blocked",
      "rank": null,
      "promotable": false,
      "meaning": "Useful local evidence of an unresolved blocker; it cannot promote state."
    }
  ],
  "packetFamilies": {
    "acceptedOrFinal": "OutcomePacketV1",
    "incompleteOrInterrupted": "ContinuationPacketV1",
    "pr14EvidencePacketDisposition": "Merge its fields into OutcomePacketV1 evidence assertions; do not retain a second packet family."
  },
  "knowledgePort": {
    "name": "KnowledgeContextPortV1",
    "operations": [
      "read_context",
      "record_outcome",
      "verify_recall"
    ],
    "adapters": [
      "exact-source",
      "repo-graph",
      "kgv2",
      "mock-kgv3"
    ],
    "rule": "Backend identity is evidence metadata and may not change core loop semantics."
  },
  "hardStops": [
    "product-law conflict",
    "same-level process authority conflict",
    "wrong root, branch, or source identity",
    "unattributed dirty path",
    "subjective expected outcome without objective assertions",
    "missing evaluator",
    "unbounded repair",
    "unknown or unreconciled external effect",
    "expired or missing approval",
    "self-review of a critical package",
    "stale or cross-root knowledge presented as current fact",
    "claim stronger than evidence"
  ]
}
