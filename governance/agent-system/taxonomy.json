  "systemTypes": [
    {
      "id": "agent-loop",
      "label": "Agent Loop",
      "purpose": "Create or change a bounded artifact through create, observe, evaluate, and repair.",
      "ownsArtifact": true,
      "requiredControls": [
        "AgentLoopContractV1",
        "objective expected outcome",
        "finite repair budget",
        "environmental observation",
        "evaluator",
        "terminal state",
        "OutcomePacketV1 or ContinuationPacketV1"
      ],
      "successRule": "Every required assertion is accepted at its declared evidence level and all effects are reconciled.",
      "mayNotClaim": [
        "success because the agent stopped",
        "success from source existence alone",
        "success with an unreconciled effect",
        "success with an unrecognized terminal state"
      ]
    },
    {
      "id": "gate",
      "label": "Gate",
      "purpose": "Allow or stop entry to a later activity by evaluating declared assertions.",
      "ownsArtifact": false,
      "requiredControls": [
        "named assertions",
        "pass or fail result",
        "evidence",
        "safe blocker output"
      ],
      "successRule": "Every declared assertion passes; any ambiguity blocks entry.",
      "mayNotClaim": [
        "that downstream work was completed",
        "that passing the gate created the downstream artifact"
      ]
    },
    {
      "id": "pipeline",
      "label": "Pipeline",
      "purpose": "Advance exact immutable identity through ordered stages.",
      "ownsArtifact": false,
      "requiredControls": [
        "ordered stages",
        "exact input identity",
        "exact output identity",
        "stage readback",
        "rollback or forward-repair rule"
      ],
      "successRule": "Every stage preserves the required identity and its environmental readback passes.",
      "mayNotClaim": [
        "release success from build success",
        "promotion of bytes different from the reviewed candidate"
      ]
    },
    {
      "id": "adapter",
      "label": "Adapter",
      "purpose": "Implement a provider behind a stable port without changing core semantics.",
      "ownsArtifact": false,
      "requiredControls": [
        "stable interface",
        "provider metadata",
        "conformance suite",
        "fallback and freshness reporting"
      ],
      "successRule": "The shared conformance suite passes and provider identity does not leak into core branching semantics.",
      "mayNotClaim": [
        "authority from provider recall",
        "core completion because one provider is reachable"
      ]
    },
    {
      "id": "evaluation-flywheel",
      "label": "Evaluation Flywheel",
      "purpose": "Convert accepted failures and successes into versioned regression cases and measured comparisons.",
      "ownsArtifact": true,
      "requiredControls": [
        "reproducible case",
        "suite and version",
        "expected result",
        "candidate identity",
        "raw result and metrics"
      ],
      "successRule": "The case reproduces, is versioned, and is included in the named suite without weakening its expected outcome.",
      "mayNotClaim": [
        "application correctness from evaluator correctness",
        "best-in-class performance without a measured comparison"
      ]
    }
  ],
