  "kind": "agent_loop_profile",
  "description": "Produces category-baseline-complete, differentiated, accessible production-entrypoint screens for one bounded actor and state, with experiments isolated and screenshot-level evidence.",
  "contract_schema_ref": "../contracts/agent-loop-contract.v1.schema.json",
  "artifact_contract": {
    "artifact_types": ["UxJourneyPacketV1", "ScreenshotEvidenceSetV1"],
    "required_fields": ["user_state", "user_journey", "one_next_action", "action_scope", "benchmark_requirement_ids", "baseline_dispositions", "benchmark_evidence_states", "layer_order", "chopdot_differentiated_outcome", "bounded_experiments", "baseline_fallbacks", "screen_states", "interaction_results", "screenshots", "accessibility_results", "viewport_results", "language_review"],
    "required_evidence_level": "simulated-integration"
  },
  "expected_outcome": {
    "statement": "For one bounded actor and state, every applicable category baseline is covered before a named ChopDot differentiator and bounded experiments; one obvious next action and all first, action, error, recovery, and after states work through the production entrypoint at declared viewports without infrastructure language or accessibility blockers.",
    "assertions": [
      { "id": "UX-BASELINE", "description": "Every applicable stable benchmark requirement has an accepted disposition and the evidence grade remains explicit.", "measurement": "unresolved_applicable_baseline_count", "operator": "count_equals", "expected": 0, "minimum_evidence_level": "source-only", "hard_fail": true },
      { "id": "UX-LAYERING", "description": "The named differentiator layers on the working baseline and every experiment preserves a tested baseline fallback.", "measurement": "ux_layer_violation_count", "operator": "count_equals", "expected": 0, "minimum_evidence_level": "unit", "hard_fail": true },
      { "id": "UX-ACTION", "description": "The first screen exposes exactly one obvious primary next action for the declared actor and state.", "measurement": "primary_next_action_count", "operator": "count_equals", "expected": 1, "minimum_evidence_level": "simulated-integration", "hard_fail": true },
      { "id": "UX-STATES", "description": "Every required interaction state is reached through the production entrypoint.", "measurement": "missing_required_screen_state_count", "operator": "count_equals", "expected": 0, "minimum_evidence_level": "simulated-integration", "hard_fail": true },
      { "id": "UX-LANGUAGE", "description": "Normal user screens contain no prohibited infrastructure or protocol diagnosis.", "measurement": "prohibited_ui_term_count", "operator": "count_equals", "expected": 0, "minimum_evidence_level": "unit", "hard_fail": true },
      { "id": "UX-ACCESS", "description": "Required keyboard, name, contrast, reflow, and touch-target checks have zero blocking failures.", "measurement": "blocking_accessibility_failure_count", "operator": "count_equals", "expected": 0, "minimum_evidence_level": "unit", "hard_fail": true },
      { "id": "UX-VIEWPORT", "description": "Every declared viewport completes without clipped primary action or horizontal overflow.", "measurement": "failed_viewport_count", "operator": "count_equals", "expected": 0, "minimum_evidence_level": "simulated-integration", "hard_fail": true }
    ]
  },
  "context_gate": { "exact_root": true, "freshness_required": true, "same_level_conflict": "blocked", "wrong_root": "blocked" },
  "policy_refs": { "authority": "agent-authority-boundaries-v1", "evidence": "agent-evidence-levels-v1", "terminal_states": "agent-terminal-states-v1", "retry_budgets": "agent-retry-budgets-v1" },
  "authority": { "default_class": "repo_local_write", "allowed_effects": ["write_in_scope_ui", "run_local_app", "capture_local_screenshot", "run_accessibility_check"], "approval_required_effects": ["publish", "deploy", "capture_real_person_data"], "critical_independent_review": true },
  "budgets": { "retry_budget_id": "budget-ux-creation-v1", "max_iterations": 3, "max_retries": 2, "same_blocker_limit": 2 },
  "evaluator": { "rubric_path": "governance/agent-system/evals/rubrics/ux-creation.v1.json", "deterministic_checks": ["benchmark_packet_semantics_check", "production_entrypoint_playwright", "viewport_overflow_check", "prohibited_language_check", "accessibility_check", "screenshot_manifest_check"], "independence": "different_actor", "pass_threshold": 0.9, "hard_failures": ["UX-BASELINE", "UX-LAYERING", "UX-ACTION", "UX-STATES", "UX-LANGUAGE", "UX-ACCESS", "UX-VIEWPORT"] },
  "evidence": { "minimum_level": "simulated-integration", "required_artifacts": ["benchmark_baseline_coverage", "ux_layering_review", "screenshot_manifest", "journey_trace", "accessibility_report", "independent_visual_review"], "exact_counts_required": true, "candidate_identity_required": true },
  "environment_observations": ["exact benchmark-baseline identity and evidence grade", "bounded actor state action and named differentiated outcome", "src/main.tsx journey", "required mobile and desktop viewports", "first action error recovery and after states"],
  "failure_packet": { "artifact_type": "ContinuationPacketV1", "required_fields": ["failed_baseline_requirement_ids", "benchmark_evidence_overclaims", "missing_baseline_fallback", "annotated_screen", "failed_journey_step", "viewport_and_actor", "severity", "precise_correction_target"], "continuation_required": true },
  "terminal_states": ["succeeded", "failed_verification", "blocked", "approval_required", "budget_exhausted", "cancelled"],
  "knowledge_preflight": { "port": "KnowledgeContextPortV1", "preflight_required": true, "record_outcome": true, "verify_recall": true, "provider_neutral": true },
  "repair_policy": { "changed_hypothesis_required": true, "scope_expansion": "new_contract", "same_blocker_limit": 2, "regression_required": true },
  "example_contract_ref": "examples/ux-creation.contract.v1.json"
}
