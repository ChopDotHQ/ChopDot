{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chopdot.dev/governance/agent-system/contracts/repair-directive.v1.schema.json",
  "title": "Repair Directive V1",
  "type": "object",
  "required": ["repair_version", "repair_id", "run_id", "iteration", "failed_assertion_ids", "falsifying_evidence", "prior_hypothesis", "changed_hypothesis", "implementation_target", "allowed_paths", "allowed_effects", "remaining_budget", "required_regression_scope", "issued_at", "issued_by"],
  "properties": {
    "repair_version": { "const": "1.0.0" },
    "repair_id": { "type": "string", "pattern": "^repair_[a-z0-9][a-z0-9_-]{5,95}$" },
    "run_id": { "type": "string", "pattern": "^run_[a-z0-9][a-z0-9_-]{7,95}$" },
    "iteration": { "type": "integer", "minimum": 1 },
    "failed_assertion_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$" } },
    "falsifying_evidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^artifact_" } },
    "prior_hypothesis": { "type": "string", "minLength": 8 },
    "changed_hypothesis": { "type": "string", "minLength": 8, "not": { "const": "retry" } },
    "implementation_target": { "type": "string", "minLength": 3 },
    "allowed_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "allowed_effects": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "remaining_budget": {
      "type": "object",
      "required": ["iterations", "retries", "wall_seconds", "tool_calls", "model_cost_usd", "external_cost_usd"],
      "properties": {
        "iterations": { "type": "integer", "minimum": 0 },
        "retries": { "type": "integer", "minimum": 0 },
        "wall_seconds": { "type": "integer", "minimum": 0 },
        "tool_calls": { "type": "integer", "minimum": 0 },
        "model_cost_usd": { "type": "number", "minimum": 0 },
        "external_cost_usd": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "required_regression_scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "issued_at": { "type": "string", "format": "date-time" },
    "issued_by": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
