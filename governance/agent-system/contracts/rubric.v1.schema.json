{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chopdot.dev/governance/agent-system/contracts/rubric.v1.schema.json",
  "title": "Objective Rubric V1",
  "type": "object",
  "required": ["rubric_version", "rubric_id", "profile_id", "score_range", "pass_threshold", "hard_fail_rules", "dimensions"],
  "properties": {
    "rubric_version": { "const": "1.0.0" },
    "rubric_id": { "type": "string", "pattern": "^rubric-[a-z0-9-]+-v1$" },
    "profile_id": { "enum": ["research", "product-definition", "implementation", "ux-creation", "security-authority", "incident-repair", "release-outcome"] },
    "score_range": { "type": "object", "required": ["minimum", "maximum"], "properties": { "minimum": { "const": 0 }, "maximum": { "const": 100 } }, "additionalProperties": false },
    "pass_threshold": { "type": "integer", "minimum": 1, "maximum": 100 },
    "hard_fail_rules": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$" } },
    "dimensions": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "weight", "measurement", "full_credit", "zero_credit", "evidence_required"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$" },
          "weight": { "type": "integer", "minimum": 1, "maximum": 100 },
          "measurement": { "type": "string", "minLength": 8 },
          "full_credit": { "type": "string", "minLength": 8 },
          "zero_credit": { "type": "string", "minLength": 8 },
          "evidence_required": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
