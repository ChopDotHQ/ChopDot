{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chopdot.dev/governance/agent-system/contracts/loop-profile.v1.schema.json",
  "title": "Loop Profile V1",
  "type": "object",
  "required": ["profile_version", "profile_id", "profile_digest", "kind", "description", "contract_schema_ref", "artifact_contract", "expected_outcome", "context_gate", "policy_refs", "authority", "budgets", "evaluator", "evidence", "environment_observations", "failure_packet", "terminal_states", "knowledge_preflight", "repair_policy", "example_contract_ref"],
  "properties": {
    "profile_version": { "const": "1.0.0" },
    "profile_id": { "enum": ["research", "product-definition", "implementation", "ux-creation", "security-authority", "incident-repair", "release-outcome"] },
    "profile_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 of RFC 8785-style canonical JSON for the profile with profile_digest omitted." },
    "kind": { "const": "agent_loop_profile" },
    "description": { "type": "string", "minLength": 12 },
    "contract_schema_ref": { "const": "../contracts/agent-loop-contract.v1.schema.json" },
    "artifact_contract": {
      "type": "object",
      "required": ["artifact_types", "required_fields", "required_evidence_level"],
      "properties": {
        "artifact_types": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]+V1$" } },
        "required_fields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "required_evidence_level": { "enum": ["source-only", "unit", "simulated-integration", "simulated-host", "exact-candidate", "real-host-chain", "live-user", "release", "local-blocked"] }
      },
      "additionalProperties": false
    },
    "expected_outcome": {
      "type": "object",
      "required": ["statement", "assertions"],
      "properties": {
        "statement": { "type": "string", "minLength": 12 },
        "assertions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/assertion" } }
      },
      "additionalProperties": false
    },
    "context_gate": {
      "type": "object",
      "required": ["exact_root", "freshness_required", "same_level_conflict", "wrong_root"],
      "properties": {
        "exact_root": { "const": true },
        "freshness_required": { "type": "boolean" },
        "same_level_conflict": { "const": "blocked" },
        "wrong_root": { "const": "blocked" }
      },
      "additionalProperties": false
    },
    "policy_refs": {
      "type": "object",
      "required": ["authority", "evidence", "terminal_states", "retry_budgets"],
      "properties": {
        "authority": { "const": "agent-authority-boundaries-v1" },
        "evidence": { "const": "agent-evidence-levels-v1" },
        "terminal_states": { "const": "agent-terminal-states-v1" },
        "retry_budgets": { "const": "agent-retry-budgets-v1" }
      },
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "required": ["default_class", "allowed_effects", "approval_required_effects", "critical_independent_review"],
      "properties": {
        "default_class": { "enum": ["read_only", "repo_local_write", "repository_effect", "external_effect", "critical_external_effect"] },
        "allowed_effects": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "approval_required_effects": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "critical_independent_review": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "budgets": {
      "type": "object",
      "required": ["retry_budget_id", "max_iterations", "max_retries", "same_blocker_limit"],
      "properties": {
        "retry_budget_id": { "type": "string", "pattern": "^budget-[a-z0-9-]+-v1$" },
        "max_iterations": { "type": "integer", "minimum": 1, "maximum": 20 },
        "max_retries": { "type": "integer", "minimum": 0, "maximum": 20 },
        "same_blocker_limit": { "type": "integer", "minimum": 1, "maximum": 5 }
      },
      "additionalProperties": false
    },
    "evaluator": {
      "type": "object",
      "required": ["rubric_path", "deterministic_checks", "independence", "pass_threshold", "hard_failures"],
      "properties": {
        "rubric_path": { "type": "string", "pattern": "^governance/agent-system/evals/rubrics/[a-z0-9-]+\\.v1\\.json$" },
        "deterministic_checks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "independence": { "enum": ["not_required", "different_run", "different_actor"] },
        "pass_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "hard_failures": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$" } }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["minimum_level", "required_artifacts", "exact_counts_required", "candidate_identity_required"],
      "properties": {
        "minimum_level": { "enum": ["source-only", "unit", "simulated-integration", "simulated-host", "exact-candidate", "real-host-chain", "live-user", "release", "local-blocked"] },
        "required_artifacts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "exact_counts_required": { "type": "boolean" },
        "candidate_identity_required": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "environment_observations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "failure_packet": {
      "type": "object",
      "required": ["artifact_type", "required_fields", "continuation_required"],
      "properties": {
        "artifact_type": { "enum": ["FailurePacketV1", "BlockerPacketV1", "ContinuationPacketV1"] },
        "required_fields": { "type": "array", "minItems": 4, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "continuation_required": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "terminal_states": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "enum": ["succeeded", "failed_verification", "blocked", "approval_required", "budget_exhausted", "cancelled"] },
      "allOf": [
        { "contains": { "const": "succeeded" } }, { "contains": { "const": "failed_verification" } }, { "contains": { "const": "blocked" } }, { "contains": { "const": "approval_required" } }, { "contains": { "const": "budget_exhausted" } }, { "contains": { "const": "cancelled" } }
      ]
    },
    "knowledge_preflight": {
      "type": "object",
      "required": ["port", "preflight_required", "record_outcome", "verify_recall", "provider_neutral"],
      "properties": {
        "port": { "const": "KnowledgeContextPortV1" },
        "preflight_required": { "type": "boolean" },
        "record_outcome": { "type": "boolean" },
        "verify_recall": { "type": "boolean" },
        "provider_neutral": { "const": true }
      },
      "additionalProperties": false
    },
    "repair_policy": {
      "type": "object",
      "required": ["changed_hypothesis_required", "scope_expansion", "same_blocker_limit", "regression_required"],
      "properties": {
        "changed_hypothesis_required": { "const": true },
        "scope_expansion": { "const": "new_contract" },
        "same_blocker_limit": { "type": "integer", "minimum": 1, "maximum": 5 },
        "regression_required": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "example_contract_ref": { "type": "string", "pattern": "^examples/[a-z0-9-]+\\.contract\\.v1\\.json$" }
  },
  "$defs": {
    "assertion": {
      "type": "object",
      "required": ["id", "description", "measurement", "operator", "expected", "minimum_evidence_level", "hard_fail"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$" },
        "description": { "type": "string", "minLength": 8 },
        "measurement": { "type": "string", "minLength": 3 },
        "operator": { "enum": ["equals", "not_equals", "truthy", "falsy", "count_equals", "count_gte", "exit_code_equals", "sha256_equals", "contains", "matches", "one_of", "all", "none"] },
        "expected": {},
        "minimum_evidence_level": { "enum": ["source-only", "unit", "simulated-integration", "simulated-host", "exact-candidate", "real-host-chain", "live-user", "release", "local-blocked"] },
        "hard_fail": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
