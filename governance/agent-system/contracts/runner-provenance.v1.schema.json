{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chopdot.dev/governance/agent-system/contracts/runner-provenance.v1.schema.json",
  "title": "Runner Provenance V1",
  "type": "object",
  "required": ["runner_provenance_version", "provenance_id", "run_id", "contract_digest", "candidate_identity", "candidate_digest", "ledger", "evaluation", "command_evidence", "artifacts", "created_at", "provenance_digest"],
  "properties": {
    "runner_provenance_version": { "const": "1.0.0" },
    "provenance_id": { "type": "string", "pattern": "^runner_provenance_[a-z0-9][a-z0-9_-]{5,95}$" },
    "run_id": { "type": "string", "pattern": "^run_[a-z0-9][a-z0-9_-]{7,95}$" },
    "contract_digest": { "$ref": "#/$defs/digest" },
    "candidate_identity": { "$ref": "#/$defs/candidate" },
    "candidate_digest": { "$ref": "#/$defs/digest" },
    "ledger": {
      "type": "object", "required": ["event_count", "head_digest", "snapshot_digest"],
      "properties": { "event_count": { "type": "integer", "minimum": 1 }, "head_digest": { "$ref": "#/$defs/digest" }, "snapshot_digest": { "$ref": "#/$defs/digest" } }, "additionalProperties": false
    },
    "evaluation": {
      "type": "object", "required": ["evaluation_id", "evaluation_digest", "record_artifact_id", "record_sha256"],
      "properties": { "evaluation_id": { "type": "string", "pattern": "^evaluation_" }, "evaluation_digest": { "$ref": "#/$defs/digest" }, "record_artifact_id": { "type": "string", "pattern": "^artifact_" }, "record_sha256": { "$ref": "#/$defs/digest" } }, "additionalProperties": false
    },
    "command_evidence": {
      "type": "object", "required": ["artifact_id", "sha256", "command_count", "command_results_digest"],
      "properties": { "artifact_id": { "type": "string", "pattern": "^artifact_" }, "sha256": { "$ref": "#/$defs/digest" }, "command_count": { "type": "integer", "minimum": 0 }, "command_results_digest": { "$ref": "#/$defs/digest" } }, "additionalProperties": false
    },
    "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } },
    "created_at": { "type": "string", "format": "date-time" },
    "provenance_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "git_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "candidate": { "type": "object", "required": ["root", "branch", "commit", "tree", "git_status"], "properties": { "root": { "type": "string", "pattern": "^/" }, "branch": { "type": "string", "minLength": 1 }, "commit": { "$ref": "#/$defs/git_sha" }, "tree": { "$ref": "#/$defs/git_sha" }, "git_status": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false },
    "artifact": { "type": "object", "required": ["artifact_id", "sha256"], "properties": { "artifact_id": { "type": "string", "pattern": "^artifact_" }, "sha256": { "$ref": "#/$defs/digest" } }, "additionalProperties": false }
  },
  "additionalProperties": false
}
