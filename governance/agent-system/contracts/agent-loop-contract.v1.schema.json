{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chopdot.dev/governance/agent-system/contracts/agent-loop-contract.v1.schema.json",
  "title": "Agent Loop Contract V1",
  "description": "Fail-closed declaration of one bounded agent-created outcome.",
  "type": "object",
  "required": [
    "contract_version",
    "run_id",
    "created_at",
    "created_by",
    "loop_profile",
    "task",
    "intent_type",
    "requirement_ids",
    "artifact_contract",
    "expected_outcome",
    "scope",
    "authority",
    "context",
    "architecture",
    "budgets",
    "evaluator",
    "environment_observations",
    "failure_outcome",
    "terminal_states",
    "knowledge_policy",
    "privacy_policy"
  ],
  "properties": {
    "contract_version": { "const": "1.0.0" },
    "run_id": { "$ref": "#/$defs/run_id" },
    "created_at": { "type": "string", "format": "date-time" },
    "created_by": { "$ref": "#/$defs/actor" },
    "loop_profile": {
      "type": "object",
      "required": ["id", "version", "path"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "version": { "const": "1.0.0" },
        "path": { "type": "string", "pattern": "^governance/agent-system/loops/[a-z0-9-]+\\.v1\\.json$" }
      },
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "required": ["title", "objective", "deliverable"],
      "properties": {
        "title": { "type": "string", "minLength": 3 },
        "objective": { "type": "string", "minLength": 12 },
        "deliverable": { "type": "string", "minLength": 3 }
      },
      "additionalProperties": false
    },
    "intent_type": {
      "enum": ["research", "product_definition", "implementation", "ux_creation", "security_authority", "incident_repair", "release_outcome"]
    },
    "requirement_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "artifact_contract": {
      "type": "object",
      "required": ["artifact_types", "required_paths", "format", "version", "hash_algorithm"],
      "properties": {
        "artifact_types": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]+V1$" } },
        "required_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/repo_path" } },
        "format": { "enum": ["json", "markdown", "source", "binary", "mixed"] },
        "version": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
        "hash_algorithm": { "const": "sha256" }
      },
      "additionalProperties": false
    },
    "expected_outcome": {
      "type": "object",
      "required": ["statement", "assertions"],
      "properties": {
        "statement": { "type": "string", "minLength": 12 },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/assertion" }
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": ["root", "branch", "starting_head", "starting_tree", "in_paths", "out_paths", "dirty_paths"],
      "properties": {
        "root": { "type": "string", "pattern": "^/" },
        "branch": { "type": "string", "minLength": 1 },
        "starting_head": { "$ref": "#/$defs/git_sha" },
        "starting_tree": { "$ref": "#/$defs/git_sha" },
        "in_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/repo_path" } },
        "out_paths": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/repo_path" } },
        "dirty_paths": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/repo_path" } }
      },
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "required": ["policy_ref", "allowed_reads", "allowed_writes", "allowed_tools", "external_effects", "required_approvals"],
      "properties": {
        "policy_ref": { "const": "governance/agent-system/policies/authority-boundaries.json" },
        "allowed_reads": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "allowed_writes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "allowed_tools": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "external_effects": { "type": "array", "uniqueItems": true, "items": { "enum": ["none", "commit", "push", "pr_create", "pr_update", "repository_setting", "credential_use", "publish", "deploy", "chain_write", "message_send", "payment"] } },
        "required_approvals": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "required": ["governing_sources", "max_age_seconds", "conflict_policy", "wrong_root_policy"],
      "properties": {
        "governing_sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source_identity" } },
        "max_age_seconds": { "type": "integer", "minimum": 0 },
        "conflict_policy": { "const": "block_same_level_conflict" },
        "wrong_root_policy": { "const": "fail_closed" }
      },
      "additionalProperties": false
    },
    "architecture": {
      "type": "object",
      "required": ["mode", "justification"],
      "properties": {
        "mode": { "enum": ["deterministic", "single_agent", "parallel_workers", "orchestrator_workers", "evaluator_optimizer"] },
        "justification": { "type": "string", "minLength": 12 }
      },
      "additionalProperties": false
    },
    "budgets": {
      "type": "object",
      "required": ["max_iterations", "max_retries", "max_wall_seconds", "max_tool_calls", "max_model_cost_usd", "max_external_cost_usd"],
      "properties": {
        "max_iterations": { "type": "integer", "minimum": 1, "maximum": 20 },
        "max_retries": { "type": "integer", "minimum": 0, "maximum": 20 },
        "max_wall_seconds": { "type": "integer", "minimum": 1 },
        "max_tool_calls": { "type": "integer", "minimum": 1 },
        "max_model_cost_usd": { "type": "number", "minimum": 0 },
        "max_external_cost_usd": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "evaluator": {
      "type": "object",
      "required": ["rubric_refs", "deterministic_commands", "reviewer_independence", "pass_threshold", "hard_fail_assertion_ids"],
      "properties": {
        "rubric_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^governance/agent-system/evals/rubrics/[a-z0-9-]+\\.v1\\.json$" } },
        "deterministic_commands": { "type": "array", "items": { "$ref": "#/$defs/command_check" } },
        "reviewer_independence": { "enum": ["not_required", "different_run", "different_actor"] },
        "pass_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "hard_fail_assertion_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      },
      "additionalProperties": false
    },
    "environment_observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "surface", "required_readback", "minimum_evidence_level"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "surface": { "type": "string", "minLength": 2 },
          "required_readback": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "minimum_evidence_level": { "$ref": "#/$defs/evidence_level" }
        },
        "additionalProperties": false
      }
    },
    "failure_outcome": {
      "type": "object",
      "required": ["required_fields", "same_blocker_limit", "continuation_required"],
      "properties": {
        "required_fields": { "type": "array", "minItems": 4, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "same_blocker_limit": { "type": "integer", "minimum": 1, "maximum": 5 },
        "continuation_required": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "terminal_states": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/terminal_state" },
      "allOf": [
        { "contains": { "const": "succeeded" } },
        { "contains": { "const": "failed_verification" } },
        { "contains": { "const": "blocked" } },
        { "contains": { "const": "approval_required" } },
        { "contains": { "const": "budget_exhausted" } },
        { "contains": { "const": "cancelled" } }
      ]
    },
    "knowledge_policy": {
      "type": "object",
      "required": ["port_version", "preflight_required", "record_outcome", "verify_recall", "degraded_context_allowed", "disallowed_fallbacks"],
      "properties": {
        "port_version": { "const": "1.0.0" },
        "preflight_required": { "type": "boolean" },
        "record_outcome": { "type": "boolean" },
        "verify_recall": { "type": "boolean" },
        "degraded_context_allowed": { "type": "boolean" },
        "disallowed_fallbacks": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "privacy_policy": {
      "type": "object",
      "required": ["prohibited_content", "redaction_required", "retention", "export_policy"],
      "properties": {
        "prohibited_content": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "redaction_required": { "type": "boolean" },
        "retention": { "enum": ["ephemeral", "local_only", "promote_redacted_outcome"] },
        "export_policy": { "enum": ["forbidden", "redacted_only", "operator_approved"] }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "run_id": { "type": "string", "pattern": "^run_[a-z0-9][a-z0-9_-]{7,95}$" },
    "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$" },
    "git_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "repo_path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "terminal_state": { "enum": ["succeeded", "failed_verification", "blocked", "approval_required", "budget_exhausted", "cancelled"] },
    "evidence_level": { "enum": ["source-only", "unit", "simulated-integration", "simulated-host", "exact-candidate", "real-host-chain", "live-user", "release", "local-blocked"] },
    "actor": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["human", "agent", "deterministic_runner", "external_system"] },
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "source_identity": {
      "type": "object",
      "required": ["path", "sha256", "authority_level", "observed_at"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "authority_level": { "enum": ["product_law", "decision", "guardrail", "measurement", "exploration"] },
        "observed_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "assertion": {
      "type": "object",
      "required": ["id", "description", "subject", "operator", "expected", "minimum_evidence_level", "hard_fail"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "description": { "type": "string", "minLength": 8 },
        "subject": { "type": "string", "minLength": 1 },
        "operator": { "enum": ["equals", "not_equals", "truthy", "falsy", "count_equals", "count_gte", "exit_code_equals", "sha256_equals", "contains", "matches", "one_of", "all", "none"] },
        "expected": {},
        "minimum_evidence_level": { "$ref": "#/$defs/evidence_level" },
        "hard_fail": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "command_check": {
      "type": "object",
      "required": ["id", "command", "cwd", "expected_exit_code", "timeout_seconds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "command": { "type": "string", "minLength": 1 },
        "cwd": { "type": "string", "pattern": "^/" },
        "expected_exit_code": { "type": "integer", "minimum": 0, "maximum": 255 },
        "timeout_seconds": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
