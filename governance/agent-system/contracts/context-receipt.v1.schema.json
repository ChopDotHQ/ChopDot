{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chopdot.dev/governance/agent-system/contracts/context-receipt.v1.schema.json",
  "title": "Context Receipt V1",
  "type": "object",
  "required": ["receipt_version", "receipt_id", "surface", "loop_profile", "candidate", "governing_sources", "active_product_card", "knowledge_state", "steering_state", "verdict", "reasons", "created_at", "receipt_digest"],
  "properties": {
    "receipt_version": { "const": "1.0.0" },
    "receipt_id": { "type": "string", "pattern": "^context_receipt_[a-z0-9]{12}$" },
    "surface": { "enum": ["task_start", "product_finish", "pr_merge", "release"] },
    "loop_profile": { "type": "string", "minLength": 1 },
    "candidate": {
      "type": "object",
      "required": ["root", "branch", "commit", "tree", "git_status"],
      "properties": {
        "root": { "type": "string", "pattern": "^/" },
        "branch": { "type": "string", "minLength": 1 },
        "commit": { "$ref": "#/$defs/git_sha" },
        "tree": { "$ref": "#/$defs/git_sha" },
        "git_status": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "governing_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "declared_sha256", "observed_sha256", "fresh", "matches"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "declared_sha256": { "$ref": "#/$defs/digest" },
          "observed_sha256": { "$ref": "#/$defs/digest" },
          "fresh": { "type": "boolean" },
          "matches": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "active_product_card": { "type": ["object", "null"] },
    "knowledge_state": {
      "type": "object",
      "required": ["current", "backend", "packet_digest", "stale_reasons"],
      "properties": {
        "current": { "type": "boolean" },
        "backend": { "type": ["string", "null"] },
        "packet_digest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "stale_reasons": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "steering_state": {
      "type": "object",
      "required": [
        "monitor_verdict",
        "registry_path",
        "registry_sha256",
        "registry_semantic_digest",
        "catalog_path",
        "catalog_digest",
        "repository_manifest_sha256",
        "worktree_manifest_sha256",
        "degraded_surface_ids",
        "disabled_surface_ids",
        "drifts",
        "route_relevance",
        "limitations"
      ],
      "properties": {
        "monitor_verdict": { "enum": ["pass", "degraded", "blocked"] },
        "registry_path": { "type": "string", "minLength": 1 },
        "registry_sha256": { "$ref": "#/$defs/digest" },
        "registry_semantic_digest": { "$ref": "#/$defs/digest" },
        "catalog_path": { "type": "string", "minLength": 1 },
        "catalog_digest": { "$ref": "#/$defs/digest" },
        "repository_manifest_sha256": { "$ref": "#/$defs/digest" },
        "worktree_manifest_sha256": { "$ref": "#/$defs/digest" },
        "degraded_surface_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "disabled_surface_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "drifts": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "route_relevance": { "const": "not_evaluated" },
        "limitations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      },
      "allOf": [
        {
          "if": { "properties": { "monitor_verdict": { "const": "degraded" } } },
          "then": { "properties": { "degraded_surface_ids": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "monitor_verdict": { "const": "blocked" } } },
          "then": { "properties": { "drifts": { "minItems": 1 } } }
        }
      ],
      "additionalProperties": false
    },
    "verdict": { "enum": ["governed", "ungoverned", "unverified"] },
    "reasons": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "created_at": { "type": "string", "format": "date-time" },
    "receipt_digest": { "$ref": "#/$defs/digest" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "steering_state": {
            "properties": { "monitor_verdict": { "const": "blocked" } }
          }
        }
      },
      "then": { "properties": { "verdict": { "const": "unverified" } } }
    }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "git_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
  },
  "additionalProperties": false
}
