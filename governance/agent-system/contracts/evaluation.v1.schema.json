{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chopdot.dev/governance/agent-system/contracts/evaluation.v1.schema.json",
  "title": "Evaluation V1",
  "type": "object",
  "required": ["evaluation_version", "evaluation_id", "run_id", "candidate_digest", "candidate_identity", "started_at", "finished_at", "evaluator", "independence", "assertions", "counts", "score", "threshold", "hard_failures", "verdict", "evidence_artifact_ids"],
  "properties": {
    "evaluation_version": { "const": "1.0.0" },
    "evaluation_id": { "type": "string", "pattern": "^evaluation_[a-z0-9][a-z0-9_-]{5,95}$" },
    "run_id": { "type": "string", "pattern": "^run_[a-z0-9][a-z0-9_-]{7,95}$" },
    "candidate_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "candidate_identity": {
      "type": "object",
      "required": ["root", "branch", "commit", "tree", "git_status"],
      "properties": {
        "root": { "type": "string", "pattern": "^/" },
        "branch": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "git_status": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "evaluator": {
      "type": "object",
      "required": ["id", "kind", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["deterministic", "rubric", "human", "agent"] },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "independence": { "enum": ["not_required", "same_actor_rejected", "different_run", "different_actor"] },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["assertion_id", "result", "evidence_level", "observed", "expected", "evidence_artifact_ids"],
        "properties": {
          "assertion_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$" },
          "result": { "enum": ["pass", "fail", "blocked"] },
          "evidence_level": { "enum": ["source-only", "unit", "simulated-integration", "simulated-host", "exact-candidate", "real-host-chain", "live-user", "release", "local-blocked"] },
          "observed": {},
          "expected": {},
          "command": { "type": "string", "minLength": 1 },
          "exit_code": { "type": "integer", "minimum": 0, "maximum": 255 },
          "evidence_artifact_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^artifact_" } }
        },
        "additionalProperties": false
      }
    },
    "counts": {
      "type": "object",
      "required": ["total", "passed", "failed", "blocked"],
      "properties": {
        "total": { "type": "integer", "minimum": 1 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "score": { "type": "number", "minimum": 0, "maximum": 1 },
    "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
    "hard_failures": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$" } },
    "verdict": { "enum": ["accepted", "rejected", "blocked"] },
    "evidence_artifact_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^artifact_" } }
  },
  "additionalProperties": false
}
