{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chopdot.dev/schemas/definition-profile.v1.schema.json",
  "title": "Evidence-bound definition profile",
  "type": "object",
  "required": [
    "schema",
    "profile_id",
    "version",
    "status",
    "framework_ref",
    "authority",
    "applies_when",
    "required_outputs",
    "evaluation_criteria",
    "proving_evidence",
    "forbidden_inferences",
    "expected_outcome"
  ],
  "properties": {
    "schema": { "const": "chopdot.definition-profile.v1" },
    "profile_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["experimental", "active", "superseded", "retired"] },
    "framework_ref": { "type": "string", "pattern": "^\\.\\./frameworks/[a-z0-9-]+\\.v1\\.json$" },
    "authority": { "type": "string", "minLength": 20 },
    "applies_when": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 5 } },
    "required_outputs": { "type": "array", "minItems": 4, "uniqueItems": true, "items": { "type": "string", "minLength": 3 } },
    "evaluation_criteria": { "type": "array", "minItems": 4, "uniqueItems": true, "items": { "type": "string", "minLength": 8 } },
    "proving_evidence": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "type": "string", "minLength": 8 } },
    "forbidden_inferences": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "type": "string", "minLength": 8 } },
    "expected_outcome": {
      "type": "object",
      "required": ["statement", "failure", "retry_exit"],
      "properties": {
        "statement": { "type": "string", "minLength": 20 },
        "failure": { "type": "string", "minLength": 12 },
        "retry_exit": { "type": "string", "minLength": 12 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
