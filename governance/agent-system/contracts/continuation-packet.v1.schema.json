{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chopdot.dev/governance/agent-system/contracts/continuation-packet.v1.schema.json",
  "title": "Continuation Packet V1",
  "type": "object",
  "required": ["continuation_version", "run_id", "contract_digest", "root", "branch", "starting_head", "starting_tree", "current_head", "current_tree", "git_status", "open_requirement_ids", "completed_requirement_ids", "last_safe_checkpoint", "unresolved_conflicts", "failed_hypotheses", "remaining_budget", "pending_approvals", "pending_effects", "next_bounded_task", "terminal_state", "created_at"],
  "properties": {
    "continuation_version": { "const": "1.0.0" },
    "run_id": { "type": "string", "pattern": "^run_[a-z0-9][a-z0-9_-]{7,95}$" },
    "contract_digest": { "$ref": "#/$defs/digest" },
    "root": { "type": "string", "pattern": "^/" },
    "branch": { "type": "string", "minLength": 1 },
    "starting_head": { "$ref": "#/$defs/git_sha" },
    "starting_tree": { "$ref": "#/$defs/git_sha" },
    "current_head": { "$ref": "#/$defs/git_sha" },
    "current_tree": { "$ref": "#/$defs/git_sha" },
    "git_status": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "open_requirement_ids": { "$ref": "#/$defs/requirement_ids" },
    "completed_requirement_ids": { "$ref": "#/$defs/requirement_ids" },
    "last_safe_checkpoint": {
      "type": "object",
      "required": ["sequence", "event_digest", "recorded_at"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 0 },
        "event_digest": { "$ref": "#/$defs/digest" },
        "recorded_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "unresolved_conflicts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "failed_hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["hypothesis", "falsifying_evidence_artifact_ids"],
        "properties": {
          "hypothesis": { "type": "string", "minLength": 8 },
          "falsifying_evidence_artifact_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^artifact_" } }
        },
        "additionalProperties": false
      }
    },
    "remaining_budget": {
      "type": "object",
      "required": ["iterations", "retries", "wall_seconds", "tool_calls", "model_cost_usd", "external_cost_usd"],
      "properties": {
        "iterations": { "type": "integer", "minimum": 0 },
        "retries": { "type": "integer", "minimum": 0 },
        "wall_seconds": { "type": "integer", "minimum": 0 },
        "tool_calls": { "type": "integer", "minimum": 0 },
        "model_cost_usd": { "type": "number", "minimum": 0 },
        "external_cost_usd": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "pending_approvals": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^approval_" } },
    "pending_effects": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^effect_" } },
    "next_bounded_task": { "type": "string", "minLength": 8 },
    "terminal_state": { "enum": ["failed_verification", "blocked", "approval_required", "budget_exhausted", "cancelled"] },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "git_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "requirement_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$" } }
  },
  "additionalProperties": false
}
