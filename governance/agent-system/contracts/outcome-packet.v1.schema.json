{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chopdot.dev/governance/agent-system/contracts/outcome-packet.v1.schema.json",
  "title": "Outcome Packet V1",
  "$comment": "For terminal_state=succeeded, the semantic validator MUST additionally enforce evaluation_summary.passed == evaluation_summary.total_assertions and evaluation_summary.score >= evaluation_summary.threshold. JSON Schema cannot compare sibling numeric properties.",
  "type": "object",
  "required": ["outcome_version", "outcome_id", "run_id", "contract_digest", "root", "branch", "starting_head", "starting_tree", "ending_head", "ending_tree", "git_status", "requirements", "artifacts", "evaluation_summary", "effects", "approvals", "evidence_index", "limitations", "terminal_state", "knowledge_receipts", "created_at", "packet_digest"],
  "properties": {
    "outcome_version": { "const": "1.0.0" },
    "outcome_id": { "type": "string", "pattern": "^outcome_[a-z0-9][a-z0-9_-]{5,95}$" },
    "run_id": { "type": "string", "pattern": "^run_[a-z0-9][a-z0-9_-]{7,95}$" },
    "contract_digest": { "$ref": "#/$defs/digest" },
    "root": { "type": "string", "pattern": "^/" },
    "branch": { "type": "string", "minLength": 1 },
    "starting_head": { "$ref": "#/$defs/git_sha" },
    "starting_tree": { "$ref": "#/$defs/git_sha" },
    "ending_head": { "$ref": "#/$defs/git_sha" },
    "ending_tree": { "$ref": "#/$defs/git_sha" },
    "git_status": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["requirement_id", "status", "evaluation_ids"],
        "properties": {
          "requirement_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$" },
          "status": { "enum": ["accepted", "failed", "blocked", "not_started"] },
          "evaluation_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^evaluation_" } }
        },
        "additionalProperties": false
      }
    },
    "artifacts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/artifact_ref" } },
    "evaluation_summary": {
      "type": "object",
      "required": ["evaluation_ids", "total_assertions", "passed", "failed", "blocked", "hard_failures", "score", "threshold", "independent_review_satisfied"],
      "properties": {
        "evaluation_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^evaluation_" } },
        "total_assertions": { "type": "integer", "minimum": 1 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "hard_failures": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$" } },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "independent_review_satisfied": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["effect_id", "state", "readback_digest"],
        "properties": {
          "effect_id": { "type": "string", "pattern": "^effect_" },
          "state": { "enum": ["verified", "failed", "unknown_needs_reconciliation"] },
          "readback_digest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "approvals": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^approval_" } },
    "evidence_index": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/artifact_ref" } },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "terminal_state": { "enum": ["succeeded", "failed_verification", "blocked", "approval_required", "budget_exhausted", "cancelled"] },
    "knowledge_receipts": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^knowledge_receipt_" } },
    "created_at": { "type": "string", "format": "date-time" },
    "packet_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "git_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "artifact_ref": {
      "type": "object",
      "required": ["artifact_id", "path", "sha256"],
      "properties": {
        "artifact_id": { "type": "string", "pattern": "^artifact_" },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "terminal_state": { "const": "succeeded" } } },
      "then": {
        "properties": {
          "evaluation_summary": {
            "properties": {
              "failed": { "const": 0 },
              "blocked": { "const": 0 },
              "hard_failures": { "maxItems": 0 },
              "independent_review_satisfied": { "const": true }
            }
          },
          "requirements": { "items": { "properties": { "status": { "const": "accepted" } } } },
          "effects": {
            "items": {
              "properties": {
                "state": { "const": "verified" },
                "readback_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
