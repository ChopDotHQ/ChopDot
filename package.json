{
  "name": "chopdot",
  "version": "1.0.0",
  "description": "ChopDot - Group expense splitting app",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "product:path-map": "node scripts/generate-user-path-coverage.mjs",
    "product:refresh": "npm run product:path-map -- refresh && node scripts/chopdot-product-cockpit.mjs refresh",
    "product:validate": "npm run product:path-map -- validate && node scripts/chopdot-product-cockpit.mjs validate && node scripts/validate-journey-reviews.mjs && npm run wiki:validate",
    "product:query": "node scripts/chopdot-product-cockpit.mjs query",
    "product:resume": "node scripts/chopdot-product-cockpit.mjs resume",
    "product:start": "node scripts/chopdot-product-cockpit.mjs start",
    "product:finish": "node scripts/chopdot-product-cockpit.mjs finish",
    "product:checkpoint": "node scripts/chopdot-product-cockpit.mjs checkpoint",
    "product:cockpit:screenshot": "node scripts/chopdot-product-cockpit.mjs screenshot",
    "product:cockpit:visual-review": "node scripts/chopdot-product-cockpit.mjs visual-review",
    "product:ai-pm:validate": "node scripts/validate-ai-pm-process.mjs",
    "wiki:ingest-thread": "node scripts/ingest-chopdot-thread.mjs",
    "wiki:generate": "node scripts/generate-chopdot-wiki.mjs",
    "wiki:validate": "node scripts/validate-chopdot-wiki.mjs",
    "wiki:sync": "npm run wiki:generate && npm run wiki:validate",
    "dot:smoke:build": "node scripts/build-chopdot-dot-smoke.mjs",
    "dot:smoke:check": "node scripts/check-chopdot-dot-smoke.mjs",
    "dot:smoke:preflight": "npm run dot:smoke:build && npm run dot:smoke:check",
    "trial:agent-wallet-payments": "node scripts/run-agent-wallet-token-scenarios.mjs",
    "validate:journey-reviews": "node scripts/validate-journey-reviews.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "bash -c 'set -a && source .env && supabase db push --db-url \"$SUPABASE_DB_URL\"'"
  },
  "dependencies": {
    "@parity/product-sdk-cloud-storage": "^0.6.6",
    "@parity/product-sdk-crypto": "^0.1.1",
    "@parity/product-sdk-signer": "^0.8.3",
    "@parity/product-sdk-statement-store": "^0.4.10",
    "@parity/product-sdk-tx": "^0.2.16",
    "@polkadot/util": "^14.0.3",
    "@polkadot/util-crypto": "^14.0.3",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.4",
    "@radix-ui/react-aspect-ratio": "^1.1.1",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-collapsible": "^1.1.2",
    "@radix-ui/react-context-menu": "^2.2.4",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-hover-card": "^1.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-menubar": "^1.1.4",
    "@radix-ui/react-navigation-menu": "^1.2.3",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slider": "^1.2.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.4",
    "@radix-ui/react-toggle": "^1.1.1",
    "@radix-ui/react-toggle-group": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@supabase/supabase-js": "^2.45.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "decimal.js": "^10.6.0",
    "grammy": "^1.44.0",
    "lucide-react": "^0.460.0",
    "motion": "^12.23.24",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-day-picker": "^8.10.1",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.55.0",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.5.5",
    "tesseract.js": "^7.0.0",
    "vaul": "^1.1.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^4.1.4"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.53.3",
    "@tailwindcss/oxide-linux-x64-gnu": "4.1.17",
    "lightningcss-linux-x64-gnu": "1.30.2"
  },
  "engines": {
    "node": "22.x",
    "npm": ">=9.0.0"
  },
  "packageManager": "npm@11.3.0",
  "keywords": [
    "expense-splitting",
    "group-finance",
    "mobile-web-app"
  ],
  "author": "ChopDot Team",
  "license": "MIT"
}
