{
  "name": "chopdot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare": "node scripts/agent-governance/install-hooks.mjs",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:dot-host": "VITE_BUILD_PROFILE=dot-host vite build --outDir dist-dot-host --emptyOutDir && node scripts/prune-dot-host-assets.mjs && node scripts/prepare-dot-host-release.mjs",
    "preview": "vite preview",
    "preview:dot-host": "vite preview --outDir dist-dot-host --port=4174 --host=127.0.0.1",
    "e2e:dot-host-preview": "DOT_HOST_PREVIEW=1 playwright test tests/dot-host-preview.spec.ts --config=playwright.dot-host-preview.config.ts --workers=1",
    "verify:dot-host": "node scripts/verify-dot-host.mjs",
    "verify:dot-host:rebuild": "node scripts/verify-dot-host-rebuild.mjs",
    "verify:dot-host:strict": "DOT_RELEASE_STRICT=1 DOT_RELEASE_LIVE=1 node scripts/verify-dot-host.mjs",
    "release:record-promotion": "node scripts/record-dot-host-promotion.mjs",
    "release:readback": "node scripts/readback-dot-host-release.mjs",
    "release:paseo-worker": "./scripts/run-worker-paseo-release.sh",
    "test:paseo-worker-release": "node --test scripts/worker-paseo-release.test.mjs scripts/worker-paseo-release-driver.test.mjs",
    "deploy:tool:verify": "node scripts/verify-locked-polkadot-app-deploy.mjs",
    "deploy:preflight:devnet": "node scripts/preflight-dotns-environment.mjs --environment=devnet",
    "deploy:preflight:paseo": "node scripts/preflight-dotns-environment.mjs --environment=paseo-next-v2",
    "test:release-tooling": "node scripts/run-release-tooling-tests.mjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "security:baseline": "node scripts/security-baseline.mjs",
    "security:runtime-boundary": "node scripts/verify-runtime-security-boundary.mjs",
    "agent:validate": "node scripts/agent-system/cli.mjs validate",
    "agent:contract:new": "node scripts/agent-system/cli.mjs contract-new",
    "agent:run:start": "node scripts/agent-system/cli.mjs run-start",
    "agent:run:resume": "node scripts/agent-system/cli.mjs run-resume",
    "agent:run:status": "node scripts/agent-system/cli.mjs run-status",
    "agent:run:cancel": "node scripts/agent-system/cli.mjs run-cancel",
    "agent:run:terminate": "node scripts/agent-system/cli.mjs run-terminate",
    "agent:run:checkpoint": "node scripts/agent-system/cli.mjs run-checkpoint",
    "agent:run:observe": "node scripts/agent-system/cli.mjs run-observe",
    "agent:run:artifact": "node scripts/agent-system/cli.mjs run-artifact",
    "agent:run:budget": "node scripts/agent-system/cli.mjs run-budget",
    "agent:run:repair": "node scripts/agent-system/cli.mjs run-repair",
    "agent:effect:plan": "node scripts/agent-system/cli.mjs effect-plan",
    "agent:approval:request": "node scripts/agent-system/cli.mjs approval-request",
    "agent:approval:record": "node scripts/agent-system/cli.mjs approval-record",
    "agent:effect:dispatch-start": "node scripts/agent-system/cli.mjs effect-dispatch-start",
    "agent:effect:dispatched": "node scripts/agent-system/cli.mjs effect-dispatched",
    "agent:effect:readback": "node scripts/agent-system/cli.mjs effect-readback",
    "agent:effect:fail": "node scripts/agent-system/cli.mjs effect-fail",
    "agent:evaluate": "node scripts/agent-system/cli.mjs evaluate",
    "agent:outcome:promote": "node scripts/agent-system/cli.mjs outcome-promote",
    "agent:continuation:promote": "node scripts/agent-system/cli.mjs continuation-promote",
    "agent:knowledge:preflight": "node scripts/agent-system/cli.mjs knowledge-preflight",
    "agent:knowledge:record": "node scripts/agent-system/cli.mjs knowledge-record",
    "agent:knowledge:verify": "node scripts/agent-system/cli.mjs knowledge-verify",
    "agent:knowledge:conformance": "node scripts/agent-system/cli.mjs knowledge-conformance",
    "agent:knowns:probe": "node scripts/agent-system/cli.mjs knowns-probe",
    "agent:instructions:validate": "node scripts/agent-system/cli.mjs instruction-validate",
    "agent:context:receipt": "node scripts/agent-governance/adoption-guard.mjs context",
    "agent:acceptance:guard": "node scripts/agent-governance/adoption-guard.mjs accept",
    "agent:hooks:install": "node scripts/agent-governance/install-hooks.mjs",
    "agent:hooks:check": "node scripts/agent-governance/adoption-guard.mjs hooks-check",
    "agent:steering:build": "node scripts/agent-governance/steering-surfaces.mjs build",
    "agent:steering:check": "node scripts/agent-governance/steering-surfaces.mjs check --require-promoted",
    "agent:steering:report": "node scripts/agent-governance/steering-surfaces.mjs report --require-promoted",
    "agent:steering:test": "node --test scripts/agent-governance/tests/steering-surfaces.test.mjs scripts/agent-governance/tests/steering-wiring.test.mjs scripts/agent-governance/tests/steering-schedule.test.mjs",
    "agent:steering:schedule:install": "node scripts/agent-governance/steering-schedule.mjs install",
    "agent:steering:schedule:status": "node scripts/agent-governance/steering-schedule.mjs status",
    "agent:steering:schedule:uninstall": "node scripts/agent-governance/steering-schedule.mjs uninstall",
    "agent:steering:schedule:test": "node --test scripts/agent-governance/tests/steering-schedule.test.mjs",
    "agent:benchmark:validate": "node scripts/agent-system/benchmark-semantics.mjs",
    "agent:eval": "node scripts/agent-system/cli.mjs eval --suite governance/agent-system/evals/suites/core.v1.json",
    "agent:ci": "node scripts/agent-governance/ci.mjs",
    "agent:ci:core": "node scripts/agent-system/cli.mjs ci",
    "agent:ci:governance": "node scripts/agent-governance/ci.mjs --governance-only",
    "agent:repo:validate": "node scripts/agent-governance/validate-repository.mjs",
    "agent:pr:validate": "node scripts/agent-governance/validate-pr.mjs",
    "agent:workflow:validate": "node scripts/agent-governance/validate-workflow.mjs",
    "agent:release:enforce": "node scripts/agent-governance/enforce-release.mjs",
    "agent:ruleset:packet": "node scripts/agent-governance/build-ruleset-packet.mjs",
    "agent:ruleset:readback": "node scripts/agent-governance/readback-ruleset.mjs",
    "test:agent:adoption": "node --test scripts/agent-governance/tests/adoption-guard.test.mjs",
    "context:validate": "node scripts/product-cockpit.mjs context-validate",
    "product:refresh": "node scripts/product-cockpit.mjs refresh",
    "product:validate": "node scripts/product-cockpit.mjs validate",
    "product:query": "node scripts/product-cockpit.mjs query",
    "product:resume": "node scripts/product-cockpit.mjs resume",
    "product:start": "node scripts/product-cockpit.mjs start",
    "product:finish": "node scripts/product-cockpit.mjs finish",
    "product:checkpoint": "node scripts/product-cockpit.mjs checkpoint",
    "product:cockpit:screenshot": "node scripts/product-cockpit.mjs screenshot",
    "product:cockpit:visual-review": "node scripts/product-cockpit.mjs visual-review",
    "test:product-cockpit": "node --test scripts/product-cockpit.test.mjs",
    "test:agent:benchmark": "node --test scripts/agent-system/tests/benchmark-semantics.test.mjs",
    "wiki:generate": "node scripts/chopdot-wiki.mjs generate",
    "wiki:validate": "node scripts/chopdot-wiki.mjs validate",
    "wiki:sync": "npm run wiki:generate && npm run wiki:validate",
    "contract:compile:pvm": "node scripts/compile-recovery-head-pvm.mjs",
    "contract:verify:pvm": "node scripts/compile-recovery-head-pvm.mjs --verify",
    "contract:hardhat:pvm": "CI=true HARDHAT_DISABLE_TELEMETRY_PROMPT=true hardhat compile --config contracts/recovery-head-index/hardhat.config.cjs --network hardhat --force && node scripts/verify-hardhat-pvm.mjs",
    "test:recovery-contract:behavior": "CI=true HARDHAT_DISABLE_TELEMETRY_PROMPT=true hardhat test --no-compile --config contracts/recovery-head-index/hardhat.behavior.config.cjs contracts/recovery-head-index/test/RecoveryHeadIndex.behavior.cjs",
    "contract:preflight:devnet": "node scripts/recovery-head-deployment.mjs --environment=devnet --preflight",
    "contract:preflight:paseo": "node scripts/recovery-head-deployment.mjs --environment=paseo-next-v2 --preflight",
    "contract:prove:devnet": "node scripts/recovery-head-deployment.mjs --environment=devnet --prove",
    "contract:prove:paseo": "node scripts/recovery-head-deployment.mjs --environment=paseo-next-v2 --prove",
    "contract:check": "node scripts/check-recovery-head-contract.mjs && npm run contract:verify:pvm",
    "test:recovery-contract": "npm run contract:check && npm run contract:hardhat:pvm && npm run test:recovery-contract:behavior && node --import tsx --test src/recovery/recoveryHeadIndex.test.ts",
    "test:node": "node scripts/run-node-tests.mjs",
    "test:release-browser": "playwright test --config=playwright.release.config.ts --workers=1",
    "test:capture-truth": "playwright test tests/capture-truth.spec.ts --config=playwright.host-sim.config.ts",
    "test:receipt-draft": "node --import tsx --test src/capture/receiptDraft.test.ts",
    "test:payment-intents": "node --import tsx --test server/payment-intents/*.test.ts",
    "test:host-adapter": "node --import tsx --test src/environment/*.test.ts",
    "test:gate0-foundation": "node --import tsx --test src/environment/accountBoundKeyEnvelope.test.ts src/environment/acceptedEventJournal.test.ts src/membership/*.test.ts",
    "test:membership-lifecycle": "node --import tsx --test src/membership/membershipLifecycle.test.ts",
    "test:signed-membership": "node --import tsx --test src/membership/*.test.ts",
    "test:wallet": "node --import tsx --test src/payments/*.test.ts",
    "test:host-sim": "playwright test tests/polkadot-host-sim.spec.ts --config=playwright.host-sim.config.ts",
    "test:host-stress": "playwright test tests/polkadot-host-five-person-stress.spec.ts --config=playwright.host-sim.config.ts",
    "test:host-ui": "playwright test tests/polkadot-host-real-ui.spec.ts --config=playwright.host-sim.config.ts",
    "test:host-wallet": "playwright test tests/polkadot-host-wallet-settlement.spec.ts --config=playwright.host-sim.config.ts",
    "test:late-expense": "node --import tsx --test src/state/store.test.ts && playwright test tests/late-expense-after-request.spec.ts --config=playwright.host-sim.config.ts",
    "test:guest-link": "node --import tsx --test src/requestLinks.test.ts src/state/store.test.ts && playwright test tests/guest-payment-return.spec.ts --config=playwright.host-sim.config.ts",
    "test:guest-link:live-dot": "playwright test tests/guest-payment-return-live-dot.spec.ts --config=playwright.live-dot.config.ts --workers=1",
    "test:live-payer-sync": "playwright test tests/live-payer-sync.spec.ts --config=playwright.host-sim.config.ts",
    "proof:host-capabilities": "node scripts/run-host-capability-proof.mjs",
    "hosts:matrix": "node -e \"const fs=require('fs'); const m=JSON.parse(fs.readFileSync('proof/host-matrix.json','utf8')); console.log(JSON.stringify(m.hosts,null,2));\"",
    "proof:web": "node scripts/run-portable-shell-proof.mjs",
    "proof:telegram": "HOST_PROFILE=telegram node scripts/run-portable-shell-proof.mjs",
    "proof:dot-host": "HOST_PROFILE=dot-host node scripts/run-portable-shell-proof.mjs",
    "test:group-invite": "node --import tsx --test src/groupInvite.test.ts",
    "proof:group-invite": "node scripts/run-group-invite-proof.mjs",
    "proof:agent-settlement": "node --import tsx scripts/run-agent-settlement-proof.mjs",
    "proof:full-loop": "node --import tsx scripts/run-full-loop-proof.mjs",
    "test:statement-budget": "playwright test tests/statement-store-notification-budget.spec.ts --config=playwright.host-sim.config.ts",
    "spike:nostr-delivery": "node scripts/spike-nostr-delivery.mjs",
    "test:session-quota": "playwright test tests/session-sync-quota.spec.ts --config=playwright.host-sim.config.ts"
  },
  "dependencies": {
    "@parity/product-sdk-address": "0.1.1",
    "@parity/product-sdk-host": "0.14.1",
    "@parity/product-sdk-statement-store": "0.6.2",
    "@parity/product-sdk-tx": "0.2.17",
    "@polkadot/util-crypto": "14.0.3",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "polkadot-api": "2.1.8",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "overrides": {
    "@parity/resolc": "1.4.0"
  },
  "devDependencies": {
    "@ipld/car": "5.4.3",
    "@ipld/dag-pb": "4.1.7",
    "@parity/hardhat-polkadot-resolc": "0.2.4",
    "@parity/host-api-test-sdk": "^0.10.0",
    "@parity/resolc": "1.4.0",
    "@playwright/test": "^1.61.1",
    "@polkadot-community-foundation/polkadot-app-deploy": "0.13.1",
    "@types/node": "^22.14.0",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "ethers": "^5.8.0",
    "hardhat": "2.26.5",
    "ipfs-unixfs": "11.2.5",
    "ipfs-unixfs-importer": "16.1.5",
    "jsqr": "^1.4.0",
    "multiformats": "13.4.1",
    "nostr-tools": "^2.24.1",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0",
    "solc": "0.8.28",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
