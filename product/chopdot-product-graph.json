  "decisions": [
    {
      "id": "ADR-001",
      "title": "Receipt capture must be photo/link/import first",
      "status": "active",
      "scope": "Catch",
      "decision": "Manual receipt item entry is correction-only, never the default capture path.",
      "context": "The Spend Card flow drifted into manual item entry, increasing friction instead of reducing it.",
      "optionsConsidered": [
        "Keep manual item entry as primary",
        "Make receipt/link/photo capture primary and hide item editing behind correction",
        "Remove item editing entirely"
      ],
      "chosenPath": "Capture first, review second, edit only if needed.",
      "evidence": [
        "EVD-TENX-JOURNEY-AUDIT"
      ],
      "risk": "Mocked capture can still feel like a form until real photo/OCR/link parsing is strong.",
      "followUp": "Run screenshot review on Spend Card after every capture change.",
      "supersedes": []
    },
    {
      "id": "ADR-002",
      "title": "Normal UI cannot expose internal technical language",
      "status": "active",
      "scope": "Quality / Agent Testing",
      "decision": "Implementation terms belong in docs, developer checks, and proof reports, not normal ChopDot screens.",
      "context": "Internal words made the app feel like a lab rather than a group-money product.",
      "optionsConsidered": [
        "Allow precise technical terms everywhere",
        "Ban technical terms from normal UI and track exceptions",
        "Remove technical terms from all docs and code"
      ],
      "chosenPath": "Ban technical terms from normal UI, keep them allowed in operator/dev contexts.",
      "evidence": [
        "EVD-PRODUCT-COCKPIT-INSTALL"
      ],
      "risk": "Automated scanners can confuse code identifiers with visible copy.",
      "followUp": "Use screenshot review and targeted UI-copy checks for critical journeys.",
      "supersedes": []
    },
    {
      "id": "ADR-003",
      "title": "Payment movement can clear the exact matching item",
      "status": "active",
      "scope": "Payout",
      "decision": "Strong recipient+amount payment movement can mark the exact payment item as received according to the flow; it must not close unrelated items.",
      "context": "Overcomplicating received money made the product feel less trustworthy.",
      "optionsConsidered": [
        "Always require manual group agreement",
        "Treat any payment movement as closing the whole pot",
        "Use strong matching movement for the exact item only"
      ],
      "chosenPath": "Exact matching movement clears the exact item; closeout still checks all remaining rules.",
      "evidence": [
        "EVD-PAS-TESTNET-TRANSFERS"
      ],
      "risk": "Weak or mismatched references could be misread as received money.",
      "followUp": "Keep mismatch/weak payment handling visible in tests and reports.",
      "supersedes": []
    },
    {
      "id": "ADR-004",
      "title": "Polkadot-native stack must be invisible to normal users",
      "status": "active",
      "scope": "Native Stack",
      "decision": "Polkadot-native capabilities are adopted only when they reduce friction or increase trust for a named journey without becoming user-facing jargon.",
      "context": "Parity's new stack is promising, but ChopDot's value is the group-money experience.",
      "optionsConsidered": [
        "Expose Polkadot features as product features",
        "Use Polkadot only in developer labs",
        "Map Polkadot capabilities to user journeys and hide stack details"
      ],
      "chosenPath": "Map native capabilities to journeys and keep normal UI user-first.",
      "evidence": [
        "EVD-NATIVE-RUNTIME-REPORT"
      ],
      "risk": "Native excitement can pull work away from the product wedge.",
      "followUp": "Keep native items blocked-live/setup-required until real host evidence changes.",
      "supersedes": []
    },
    {
      "id": "ADR-005",
      "title": "Logos cockpit pattern becomes ChopDot operating cockpit",
      "status": "active",
      "scope": "Quality / Agent Testing",
      "decision": "Use the Logos cockpit pattern, but keep ChopDot cockpit truth local to this repo.",
      "context": "ChopDot had scattered plans, scorecards, journey docs, and tests without one connected operating map.",
      "optionsConsidered": [
        "Keep separate docs",
        "Use Logos Lab as the central product database",
        "Install a ChopDot-owned cockpit based on Logos patterns"
      ],
      "chosenPath": "Create `product/` in ChopDot with local graph, generated views, evidence, and validators.",
      "evidence": [
        "EVD-PRODUCT-COCKPIT-INSTALL"
      ],
      "risk": "Cockpit bloat can recreate the same noise it is meant to prevent.",
      "followUp": "Keep core cockpit small and add fields only after dogfooding.",
      "supersedes": []
    }
  ],
