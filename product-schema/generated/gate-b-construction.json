  "laws": [
    {
      "id": "LAW-ID-01",
      "name": "Participant identity survives account linking",
      "applies_to": [
        "identity.participant",
        "identity.account"
      ],
      "rule": "Link/upgrade preserves the same group-scoped participant_id and every historical expense/split/history/export/recovery reference.",
      "sources": [
        "C1_IDENTITY",
        "POST_J28"
      ]
    },
    {
      "id": "LAW-ID-02",
      "name": "No name/email identity merge",
      "applies_to": [
        "identity.participant"
      ],
      "rule": "Display name and email are never identity merge keys; collisions/mismatch remain unresolved.",
      "sources": [
        "C1_IDENTITY",
        "POST_J28"
      ]
    },
    {
      "id": "LAW-ID-03",
      "name": "Group-scoped unlinkability",
      "applies_to": [
        "identity.participant",
        "identity.account"
      ],
      "rule": "Group-visible identity must not expose a stable identifier that correlates an account-backed person across groups.",
      "sources": [
        "POST_J28",
        "C1_IDENTITY"
      ]
    },
    {
      "id": "LAW-AUTH-01",
      "name": "Presentation/preferences are not authority",
      "applies_to": [
        "account.preferences",
        "payment.destination",
        "wallet.session",
        "notification.delivery"
      ],
      "rule": "A saved preference, destination, notification or wallet connection does not itself create payment/signing/group/identity-provider authority.",
      "sources": [
        "DESIGN",
        "J20",
        "J21",
        "J27"
      ]
    },
    {
      "id": "LAW-MONEY-01",
      "name": "Exact partitioned money",
      "applies_to": [
        "money.money_v1"
      ],
      "rule": "Canonical financial conservation uses integer minor units with currency and exponent; cross-partition values never combine silently and display decimals are non-authoritative.",
      "sources": [
        "C1_SPEND",
        "C1_README",
        "J11"
      ]
    },
    {
      "id": "LAW-HIST-01",
      "name": "Replay is side-effect free",
      "applies_to": [
        "event.accepted",
        "event.outbox",
        "payment.record"
      ],
      "rule": "Accepted history is append-only/replay-safe; replay rebuilds projections and never repeats external/payment/signing/receipt/closure effects.",
      "sources": [
        "STORAGE_REPLAY",
        "J11",
        "J15"
      ]
    },
    {
      "id": "LAW-EXP-01",
      "name": "Expense split conserves amount",
      "applies_to": [
        "expense.expense",
        "expense.split",
        "money.money_v1"
      ],
      "rule": "An explicit custom split must add to the Expense total within the exact money partition.",
      "sources": [
        "J05"
      ]
    },
    {
      "id": "LAW-EXP-02",
      "name": "Review and edit ownership stay separate",
      "applies_to": [
        "expense.expense",
        "expense.review",
        "expense.issue"
      ],
      "rule": "Journey 06 owns expense mutation; Journey 07 owns agreement/question/issue semantics. Owner correction does not fabricate reviewer agreement.",
      "sources": [
        "J06",
        "J07"
      ]
    },
    {
      "id": "LAW-ISSUE-01",
      "name": "Issues block only dependencies",
      "applies_to": [
        "expense.issue",
        "payment.intent"
      ],
      "rule": "An unresolved expense issue blocks only dependent payment items, not unrelated actionable balances.",
      "sources": [
        "J07",
        "J11"
      ]
    },
    {
      "id": "LAW-POS-01",
      "name": "Position is derived and currency-separated",
      "applies_to": [
        "position.position"
      ],
      "rule": "Position is a read model; mixed currencies remain separate and source group/item lineage stays explainable.",
      "sources": [
        "J10",
        "J11"
      ]
    },
    {
      "id": "LAW-PAY-03",
      "name": "Partial closes exact confirmed amount",
      "applies_to": [
        "payment.intent",
        "payment.record",
        "position.position"
      ],
      "rule": "A partial payment closes only the confirmed portion; the remainder preserves source lineage and stays open.",
      "sources": [
        "J11",
        "J12",
        "J15"
      ]
    },
    {
      "id": "LAW-ACT-01",
      "name": "Activity and notification are projections",
      "applies_to": [
        "activity.item",
        "activity.attention",
        "notification.delivery"
      ],
      "rule": "Activity is read-only; unread is not unresolved; notification delivery/read cannot mutate the underlying domain result.",
      "sources": [
        "J18"
      ]
    },
    {
      "id": "LAW-GROUP-01",
      "name": "Archive is not settlement or deletion",
      "applies_to": [
        "group.group"
      ],
      "rule": "Archive is reversible organization state; it does not forgive/net/settle/delete balances or history.",
      "sources": [
        "J26"
      ]
    },
    {
      "id": "LAW-GROUP-02",
      "name": "Access/lifecycle does not rewrite ledger truth",
      "applies_to": [
        "group.group",
        "group.membership"
      ],
      "rule": "Removal, leave, transfer, rename, archive and delete prerequisites cannot silently rewrite expense attribution, balances, historical ledger facts or other memberships.",
      "sources": [
        "J09",
        "J26"
      ]
    },
    {
      "id": "LAW-ACCOUNT-01",
      "name": "Account deletion respects adjacent authority",
      "applies_to": [
        "identity.account",
        "group.group",
        "payment.intent"
      ],
      "rule": "Deletion is blocked by group ownership or unresolved money obligations, routes to their owning journeys, and makes no global erasure claim.",
      "sources": [
        "J27"
      ]
    }
  ],
