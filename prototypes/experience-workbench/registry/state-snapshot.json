  "decisions": [
    {
      "id": "D001",
      "date": "2026-09-03",
      "journey": "02",
      "status": "approved",
      "decision": "Home is attention-first and group-first, not wallet-first or finance-dashboard-first.",
      "reason": "Opening ChopDot should immediately answer what needs attention, which group matters, and the next action."
    },
    {
      "id": "D002",
      "date": "2026-09-03",
      "journey": "02",
      "status": "approved",
      "decision": "Wallet/crypto details are removed from the primary Home hierarchy.",
      "reason": "Technical payment rails should surface contextually, not define the product's first impression."
    },
    {
      "id": "D003",
      "date": "2026-09-03",
      "journey": "02",
      "status": "approved",
      "decision": "Each group card exposes current state and a meaningful next action.",
      "reason": "Groups are the main product objects; users should not have to open each one just to learn whether something needs them."
    },
    {
      "id": "D004",
      "date": "2026-09-03",
      "journey": "03",
      "status": "draft",
      "decision": "Core expense-group creation requires only a group name; currency is visible but preselected.",
      "reason": "Create the shared space first; configure people/payment sophistication when it becomes relevant."
    },
    {
      "id": "D005",
      "date": "2026-09-03",
      "journey": "03",
      "status": "draft",
      "decision": "Savings creation is separated from the core expense-group creation journey.",
      "reason": "Savings has a different mental model and should not add cognitive load to the most common creation path."
    },
    {
      "id": "D006",
      "date": "2026-09-03",
      "journey": "03",
      "status": "draft",
      "decision": "Wallet addresses are not requested during group creation.",
      "reason": "Invite people as people; request payment rails only when payment needs them."
    },
    {
      "id": "D007",
      "date": "2026-09-03",
      "journey": "02",
      "status": "approved",
      "decision": "Home review prototypes must use normal HTML-link navigation for core paths; JavaScript-only navigation is not acceptable for mobile review artifacts.",
      "reason": "The ChatGPT/iPhone file preview did not reliably execute the earlier JavaScript interactions."
    },
    {
      "id": "D008",
      "date": "2026-09-03",
      "journey": "02",
      "status": "approved",
      "decision": "When nothing needs attention, Home explicitly says the user is caught up rather than removing the attention region without explanation.",
      "reason": "The attention-first model needs a coherent zero-attention state, not a disappearing hierarchy."
    },
    {
      "id": "D009",
      "date": "2026-09-03",
      "journey": "02",
      "status": "draft",
      "decision": "Cross-currency Home totals require a dedicated product rule before implementation.",
      "reason": "Summing CHF, USD, EUR, or DOT into one unqualified 'overall position' would be misleading."
    },
    {
      "id": "D010",
      "date": "2026-09-03",
      "journey": "02",
      "status": "approved",
      "decision": "Current-state and redesigned prototypes use the same app frame: fixed header, scrollable content region, and reserved footer/navigation.",
      "reason": "Shared framing prevents overlap bugs and makes current-vs-new comparisons about UX rather than layout artifacts."
    },
    {
      "id": "D011",
      "date": "2026-09-03",
      "journey": "02",
      "status": "approved",
      "decision": "Wallet context remains visible on Home as a compact secondary strip.",
      "reason": "Wallet balance and connection are useful context, but should not outrank attention and group state."
    },
    {
      "id": "D012",
      "date": "2026-09-03",
      "journey": "02",
      "status": "approved",
      "decision": "Home copy should be short, scannable, and action-led; variable text must clamp or truncate safely.",
      "reason": "The user should understand state from hierarchy and labels, not long explanatory sentences."
    },
    {
      "id": "D013",
      "date": "2026-09-03",
      "journey": "02",
      "status": "approved",
      "decision": "The ChopDot mobile app frame is viewport-locked: header and footer remain visible while only the center content region scrolls.",
      "reason": "Primary navigation and core actions should never require scrolling to rediscover them."
    },
    {
      "id": "D014",
      "date": "2026-09-03",
      "journey": "02",
      "status": "draft",
      "decision": "Recommended Home hierarchy is Attention \u2192 Wallet \u2192 Overall Position \u2192 Groups.",
      "reason": "Wallet context matters, but unresolved shared-money tasks should remain the first actionable information."
    },
    {
      "id": "D015",
      "date": "2026-09-03",
      "journey": "02",
      "status": "approved",
      "decision": "Prototype QA requires rendered screenshots at representative phone sizes and visual comparison against the last approved reference.",
      "reason": "Structural/code review alone allowed visual regressions in density, hierarchy, and spacing."
    }
  ],
