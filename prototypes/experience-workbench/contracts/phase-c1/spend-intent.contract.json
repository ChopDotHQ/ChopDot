{
  "$id": "chopdot://contracts/spend-intent/SPEND-01/v1",
  "version": 1,
  "security_revision": 5,
  "kind": "rail-neutral-domain-model",
  "economic_domain": "merchant_spend_before_or_during_purchase",
  "creates_user_journey": false,
  "execution_mode_selected": false,
  "identity": {
    "required": [
      "spend_intent_id",
      "operation_id"
    ],
    "spend_intent_id": "stable intent identity",
    "operation_id": "exact execution/recovery operation identity",
    "reconciliation_reuses_operation_id": true,
    "unknown_allows_fresh_dispatch": false,
    "new_dispatch_after_verified_no_effect_failure_requires_new_operation_id": true,
    "new_dispatch_after_possible_effect_failure_allowed": false
  },
  "required_fields": [
    "spend_intent_id",
    "operation_id",
    "group_id",
    "participants",
    "shares",
    "funding_rule",
    "source_mode_adapter",
    "policy_snapshot",
    "approval_snapshot",
    "lifecycle_state",
    "authorization_state",
    "funding_state",
    "execution_state",
    "authorized_amount",
    "authorized_asset",
    "authorization_version"
  ],
  "source_mode_adapter": {
    "adapter_id": null,
    "mode": "unselected",
    "boundary": "Concrete rails translate mode-specific authorization/funding/execution observations into this shared contract without changing its identity, authority or truth rules.",
    "callbacks_are_observations_only": true,
    "callback_success_may_mark_captured_without_proof": false,
    "possible_future_adapter": {
      "mode": "polkadot_cash",
      "production_ready": false,
      "merchant_card_capability_claimed": false
    }
  },
  "lifecycle_states": [
    "draft",
    "reviewed",
    "authorized",
    "pending",
    "captured",
    "partial",
    "unknown",
    "failed",
    "reversed",
    "cancelled"
  ],
  "authorization_states": [
    "not_requested",
    "reviewed",
    "authorized",
    "denied",
    "expired"
  ],
  "funding_states": [
    "unfunded",
    "reserved",
    "partially_funded",
    "funded",
    "released",
    "unknown"
  ],
  "execution_states": [
    "not_started",
    "pending",
    "captured",
    "partial",
    "unknown",
    "failed",
    "reversed",
    "cancelled"
  ],
  "operation_value": {
    "authorized_amount_field": "authorized_amount",
    "authorized_asset_field": "authorized_asset",
    "authorization_version_field": "authorization_version",
    "immutable_within_authorization_version": true,
    "cumulative_capture_or_partial_may_exceed_authorized_amount": false,
    "bound_change_requires_explicit_versioned_authorized_adjustment": true,
    "versioned_authorized_adjustment_rebinds_policy_and_approval_snapshots": true,
    "operation_asset_must_remain_constant": true,
    "authorization_adjustment_requires_fresh_current_authority": true,
    "authorization_adjustment_requires_unique_replay_protected_id": true,
    "authorization_adjustment_requires_prior_and_next_version_binding": true,
    "authorization_adjustment_requires_current_authorizer_capability": true,
    "authorization_adjustment_requires_fresh_policy_and_approval_snapshots": true,
    "pending_or_unknown_prior_execution_may_gain_fresh_dispatch_authority_from_adjustment": false
  },
  "authorization_adjustment": {
    "identity_field": "authorization_adjustment_id",
    "required_fields": [
      "authorization_adjustment_id",
      "spend_intent_id",
      "operation_id",
      "prior_authorization_version",
      "authorization_version",
      "authorized_amount",
      "authorized_asset",
      "policy_snapshot_digest",
      "approval_snapshot_digest",
      "authorizer_participant_id",
      "authorizer_capability_id",
      "authorizer_capability_version",
      "authority_proof_ref"
    ],
    "unique_id_required": true,
    "replay_allowed": false,
    "prior_version_must_equal_current": true,
    "next_version_must_equal_prior_plus_one": true,
    "asset_must_equal_operation_asset": true,
    "new_amount_must_cover_already_captured_value": true,
    "policy_snapshot_digest_must_be_fresh_for_new_version": true,
    "approval_snapshot_digest_must_be_fresh_for_new_version": true,
    "current_authorizer_required": true,
    "current_capability_required": true,
    "effect_time_authority_revalidation_required": true,
    "authorizer_scope": "spend_authorization_adjustment",
    "pending_or_unknown_prior_execution_blocks_adjustment": true,
    "adjustment_may_create_dispatch_authority_before_reconciliation": false
  },
  "proof": {
    "required_for_financial_materialization": true,
    "shape": [
      "source",
      "proof_id",
      "observed_at",
      "spend_intent_id",
      "operation_id",
      "effect_id",
      "authoritative_effect_ref",
      "adapter_id",
      "rail_identity",
      "amount",
      "asset",
      "authorization_version",
      "target_digest",
      "policy_snapshot_digest",
      "approval_snapshot_digest",
      "finality",
      "readback_ref"
    ],
    "target_digest_semantics": "adapter-specific immutable digest of the exact destination/payee/merchant/effect target",
    "confirmation_source_must_be_recorded": true,
    "exact_binding_required": [
      "spend_intent_id",
      "operation_id",
      "effect_id",
      "authoritative_effect_ref",
      "adapter_id",
      "rail_identity",
      "amount",
      "asset",
      "authorization_version",
      "target_digest",
      "policy_snapshot_digest",
      "approval_snapshot_digest"
    ],
    "exact_binding_required_fields_must_be_present_non_null_non_empty": true,
    "proof_reuse_across_another_intent_operation_effect_or_target_allowed": false,
    "authoritative_effect_ref_must_be_stable_for_same_external_effect": true,
    "same_authoritative_effect_ref_may_materialize_multiple_internal_effect_ids": false,
    "required_finality_or_authoritative_readback": true,
    "adapter_authoritative_verifier_required": true,
    "accepted_terminal_finality_must_be_declared_by_adapter": true,
    "explicit_nonterminal_finality_classes": [
      "pending",
      "unknown",
      "observed",
      "submitted",
      "accepted"
    ],
    "readback_ref_must_be_verified_by_adapter_authoritative_source": true,
    "arbitrary_nonempty_readback_ref_is_sufficient": false,
    "callback_completed_is_authoritative_proof": false,
    "host_callback_alone_is_canonical_spend_proof": false
  },
  "materialization": {
    "mode": "exactly_once",
    "idempotency_key": "spend_intent_id + authoritative_effect_ref",
    "internal_effect_id_is_not_authoritative_dedupe_identity": true,
    "authoritative_effect_ref_required_before_dedupe": true,
    "one_authoritative_effect_ref_maps_to_at_most_one_canonical_effect": true,
    "targets": [
      "canonical_expense",
      "canonical_obligation",
      "group_financial_state"
    ],
    "one_proven_effect_derives_financial_state_once": true,
    "authorized_is_spent": false,
    "unknown_may_materialize_new_spend": false,
    "duplicate_effect_proof_may_duplicate_expense": false,
    "proof_binding_must_validate_before_materialization": true,
    "net_materialized_value_formula": "sum(proven_capture_and_partial_effects) - sum(proven_refund_and_reversal_adjustments)"
  },
  "payment_intent_boundary": {
    "separate_economic_domain": true,
    "payment_intent_purpose": "settle_already_existing_obligations",
    "spend_intent_purpose": "coordinate_value_before_or_during_purchase",
    "payment_intent_may_settle_derived_obligation": true,
    "payment_intent_may_create_or_recreate_merchant_spend": false,
    "payment_intent_may_duplicate_spend_materialization": false
  },
  "lineage": {
    "capture_kinds": [
      "capture",
      "partial_capture"
    ],
    "adjustment_kinds": [
      "refund",
      "reversal"
    ],
    "partial_capture_requires_parent": true,
    "refund_requires_parent_capture": true,
    "reversal_requires_parent_capture": true,
    "all_adjustments_remain_on_original_operation_lineage": true,
    "authoritative_effect_ref_unique_within_operation": true,
    "adjustment_requires_parent_capture_effect_id": true,
    "adjustment_asset_must_equal_parent_capture_asset": true,
    "adjustment_amount_may_exceed_parent_remaining_consumable": false,
    "refund_and_reversal_share_parent_remaining_consumable": true,
    "duplicate_authoritative_adjustment_effect_allowed": false,
    "fields": [
      "lineage_id",
      "parent_lineage_id",
      "effect_id",
      "authoritative_effect_ref",
      "parent_capture_effect_id",
      "kind",
      "amount",
      "asset",
      "proof_ref"
    ]
  },
  "failure_semantics": {
    "failed_state_means": "proven_no_external_effect_or_dispatch",
    "failed_requires_authoritative_no_effect_proof": true,
    "pre_effect_failure_may_be_failed": true,
    "possible_effect_failure_must_be_unknown": true,
    "transport_or_timeout_after_possible_dispatch_must_be_unknown": true,
    "failed_without_no_effect_proof_is_valid": false,
    "fresh_operation_after_failed_requires_verified_no_effect": true,
    "fresh_operation_after_unknown_allowed": false
  },
  "recovery": {
    "pending_requires_reconciliation_before_retry": true,
    "unknown_requires_reconciliation_before_retry": true,
    "unknown_may_create_new_authority": false,
    "unknown_may_dispatch_fresh_value": false,
    "reconciliation_reuses_exact_operation_id": true,
    "fresh_operation_after_verified_no_effect_failure_uses_new_operation_id": true,
    "terminal_failure_without_no_effect_proof_may_retry": false,
    "recovery_preserves_spend_intent_id": true
  },
  "policy": {
    "policy_snapshot_is_immutable_within_authorization_version": true,
    "approval_snapshot_is_immutable_within_authorization_version": true,
    "authorization_adjustment_must_rebind_fresh_policy_and_approval_snapshots": true,
    "proof_must_bind_policy_and_approval_snapshot_digests": true,
    "proof_must_bind_authorization_version": true,
    "capability_check_uses_member_identity": true,
    "identity_upgrade_during_operation_may_change_economic_subject": false,
    "unknown_or_pending_execution_blocks_fresh_dispatch_authority_after_adjustment": true
  },
  "research_boundary": {
    "selected_modes": [],
    "not_approved": [
      "multi_source_merchant_card",
      "joint_bank_account_or_pot",
      "issuer_or_baas",
      "generic_merchant_card_issuance",
      "apple_pay_or_google_pay_provisioning"
    ],
    "future_mode_must_implement_adapter_boundary": true
  }
}
