  "laws": [
    {
      "id": "LAW-ID-01",
      "name": "Participant identity survives account linking",
      "applies_to": [
        "identity.participant",
        "identity.account"
      ],
      "rule": "Link/upgrade preserves the same group-scoped participant_id and every historical expense/split/history/export/recovery reference.",
      "sources": [
        "C1_IDENTITY",
        "POST_J28"
      ],
      "safety_class": "identity",
      "constraint": {
        "kind": "stable_participant_identity",
        "participant_id_stable": true,
        "account_link_replaces_participant": false,
        "historical_reference_rewrite": false
      },
      "machine_checkable": true
    },
    {
      "id": "LAW-ID-02",
      "name": "No name/email identity merge",
      "applies_to": [
        "identity.participant"
      ],
      "rule": "Display name and email are never identity merge keys; collisions/mismatch remain unresolved.",
      "sources": [
        "C1_IDENTITY",
        "POST_J28"
      ],
      "safety_class": "identity",
      "constraint": {
        "kind": "identity_merge_prohibition",
        "prohibited_merge_keys": [
          "display_name",
          "email"
        ],
        "collision_or_mismatch": "unresolved"
      },
      "machine_checkable": true
    },
    {
      "id": "LAW-ID-03",
      "name": "Group-scoped unlinkability",
      "applies_to": [
        "identity.participant",
        "identity.account"
      ],
      "rule": "Group-visible identity must not expose a stable identifier that correlates an account-backed person across groups.",
      "sources": [
        "POST_J28",
        "C1_IDENTITY"
      ],
      "safety_class": "identity",
      "constraint": {
        "kind": "group_scoped_unlinkability",
        "group_visible_cross_group_stable_identifier": false,
        "account_binding_may_be_private": true
      },
      "machine_checkable": true
    },
    {
      "id": "LAW-QR-01",
      "name": "QR is transport only",
      "applies_to": [
        "qr.payload"
      ],
      "rule": "A QR payload is inert until owner-journey validation and cannot itself create membership, payment, destination or wallet authority.",
      "sources": [
        "APPROVAL_22_v1"
      ],
      "machine_checkable": false,
      "machine_checkable_reason": "Source-grounded prose law; not selected as a V1 safety-critical machine contract."
    },
    {
      "id": "LAW-SAV-02",
      "name": "Savings authority is explicit",
      "applies_to": [
        "savings.position",
        "savings.operation"
      ],
      "rule": "Participant positions remain participant-owned by default; group-controlled withdrawal follows the configured rule and ChopDot never fabricates custody/confirmation.",
      "sources": [
        "J16",
        "J17"
      ],
      "machine_checkable": true,
      "safety_class": "authority",
      "constraint": {
        "kind": "explicit_savings_authority",
        "participant_position_owned_by_participant": true,
        "group_controlled_withdrawal_requires_configured_rule": true,
        "fabricated_custody_allowed": false,
        "fabricated_confirmation_allowed": false
      }
    },
    {
      "id": "LAW-GROUP-02",
      "name": "Access/lifecycle does not rewrite ledger truth",
      "applies_to": [
        "group.group",
        "group.membership"
      ],
      "rule": "Removal, leave, transfer, rename, archive and delete prerequisites cannot silently rewrite expense attribution, balances, historical ledger facts or other memberships.",
      "sources": [
        "J09",
        "J26"
      ],
      "safety_class": "composition_continuity",
      "constraint": {
        "kind": "lifecycle_preserves_ledger_truth",
        "ledger_rewrite_on_lifecycle": false,
        "protected_facts": [
          "expense_attribution",
          "balances",
          "historical_ledger",
          "other_memberships"
        ]
      },
      "machine_checkable": true
    },
    {
      "id": "LAW-EXP-03",
      "name": "Expense allocation preserves participant attribution",
      "applies_to": [
        "expense.expense",
        "expense.split",
        "expense.allocation",
        "group.membership",
        "identity.participant",
        "money.money_v1"
      ],
      "rule": "Every allocation entry is bound to a selected participant_id in the Expense's Group and carries MoneyV1 in the Expense partition. Correct total conservation never substitutes for correct per-participant attribution.",
      "constraint": {
        "kind": "allocation_participant_membership",
        "allocation_identity": [
          "expense_id",
          "participant_id"
        ],
        "membership_scope": "expense.group_id",
        "money_partition": "expense.amount"
      },
      "sources": [
        "J05",
        "J05_STATE",
        "C1_IDENTITY"
      ],
      "machine_checkable": true
    },
    {
      "id": "LAW-EXP-GUARD-01",
      "name": "Expense mutation obeys current settlement-related guard",
      "applies_to": [
        "expense.mutation_guard",
        "expense.expense",
        "payment.intent",
        "payment.settlement_scope"
      ],
      "rule": "For ordinary settlements, block Expense create/edit/delete when current or proposed state changes financial truth used by any unresolved settlement. Safe allow requires complete current/proposed evidence, a complete settlement descriptor, before/after dependency snapshots, and fresh authoritative reconciliation for any released scope.",
      "constraint": {
        "kind": "effect_guard_required",
        "operations": [
          "expense.create",
          "expense.edit",
          "expense.delete"
        ],
        "guard": "expense.mutation_guard",
        "policy": "dependency_scoped_economic_guard",
        "dependency_dimensions": [
          "frozen_source_item_lineage",
          "payer_recipient_pair",
          "currency_partition",
          "current_eligible_balance",
          "dispute_eligibility",
          "open_partial_remainder"
        ],
        "state_evaluation": "current_and_proposed_post_state",
        "dependency_scoped": {
          "create": "block_if_proposed_state_changes_active_settlement_dependency",
          "edit": "block_if_current_or_proposed_state_changes_active_settlement_dependency",
          "delete": "block_if_current_state_changes_active_settlement_dependency"
        },
        "active_scope": {
          "source": "payment.intent + payment.settlement_scope + position.position + expense.issue + authoritative reconciliation",
          "fail_closed": true,
          "required_guard_inputs": [
            "operation",
            "group_id",
            "active_settlements",
            "evaluated_state_as_of",
            "current_or_proposed_state_per_operation",
            "dependency_snapshot_before_by_payment_id",
            "dependency_snapshot_after_by_payment_id"
          ],
          "incomplete_input": "fail_closed",
          "required_settlement_fields": [
            "payment_id",
            "payer_participant_id",
            "recipient_participant_id",
            "currency",
            "source_item_ids",
            "prepared_amount_minor_units",
            "resolution_status"
          ],
          "terminality": {
            "field": "resolution_status",
            "allowed": [
              "active",
              "unknown_effect",
              "open_remainder",
              "authoritative_terminal",
              "reconciled_no_effect"
            ],
            "closed_enumeration": true,
            "unrecognized_or_malformed_state": "fail_closed",
            "unresolved": [
              "active",
              "unknown_effect",
              "open_remainder"
            ],
            "release_candidates": [
              "authoritative_terminal",
              "reconciled_no_effect"
            ]
          },
          "reconciliation_evidence": {
            "authority_required": true,
            "authority_field": "authority_verified",
            "as_of_required": true,
            "as_of_field": "as_of",
            "must_not_predate_evaluated_state": true
          },
          "dependency_snapshot": {
            "every_unresolved_payment_required": true,
            "fields": [
              "eligible_balance_minor_units",
              "dispute_eligible",
              "source_item_ids"
            ],
            "balance_must_be_finite": true,
            "dispute_eligible_must_be_boolean": true,
            "source_item_ids_must_be_array": true,
            "any_balance_change_requires_block": true,
            "any_dispute_eligibility_change_requires_block": true,
            "any_source_lineage_change_requires_block": true,
            "missing_or_malformed": "fail_closed"
          },
          "condition": "a settlement is unresolved unless it is in an allowed release state with authoritative reconciliation evidence at least as fresh as the evaluated state",
          "release": "authoritative terminal/no-effect truth, fresh reconciliation evidence, and no open remainder referencing the dependency"
        },
        "explanation_required": true
      },
      "sources": [
        "J05",
        "J05_STATE",
        "J05_RECOVERED",
        "J06",
        "J06_STATE",
        "J08",
        "J08_DECISION",
        "J11",
        "DEC_EXP_LOCK",
        "DEC_EXP_LOCK_V2"
      ],
      "machine_checkable": true,
      "safety_class": "settlement"
    },
    {
      "id": "LAW-EXP-REVIEW-01",
      "name": "Stale Expense review must not remain current",
      "applies_to": [
        "expense.expense",
        "expense.review"
      ],
      "rule": "Any Expense edit accepted by the Journey 06 Save changes path resets the reviews that were current at edit acceptance to `needs review again`, including a reviewer who the edit removes from the split. Review history remains readable. An open issue remains unresolved until Journey 07 records reviewer resolution.",
      "constraint": {
        "kind": "successful_edit_resets_current_reviews",
        "trigger": {
          "journey": "06",
          "operation": "expense.edit",
          "path": "Save changes",
          "persistence": "accepted"
        },
        "affected_reviews": {
          "basis": "reviewers_current_at_edit_acceptance",
          "include_removed_participants": true
        },
        "current_result": "needs_review_again",
        "preserve_prior_review_history": true,
        "open_issue_resolution": "remains unresolved until Journey 07 reviewer action",
        "owner_edit_cannot_resolve_issue": true
      },
      "sources": [
        "J06",
        "J06_STATE",
        "J06_DECISION",
        "J07",
        "J07_STATE"
      ],
      "machine_checkable": true
    },
    {
      "id": "LAW-POS-SCOPE-01",
      "name": "Position scope is typed",
      "applies_to": [
        "position.scope",
        "position.position",
        "payment.settlement_scope"
      ],
      "rule": "Position scope is explicitly participant_pair or group. Settlement dependency/eligibility consumes participant_pair scope only; group scope remains a distinct read projection.",
      "constraint": {
        "kind": "typed_position_scope",
        "allowed_scope_kinds": [
          "participant_pair",
          "group"
        ],
        "settlement_required_scope_kind": "participant_pair",
        "currency_partition_on_position": true
      },
      "sources": [
        "J08",
        "J10",
        "J11"
      ],
      "safety_class": "settlement",
      "machine_checkable": true
    }
  ],
  "objects": [
    {
      "id": "identity.participant",
      "name": "Participant",
      "kind": "entity",
      "domain": "identity_access",
      "identity": [
        "group_id",
        "participant_id"
