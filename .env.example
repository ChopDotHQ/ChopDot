# Public development template for main. No real credentials belong here.
# dev:frontend supplies loopback placeholders and does not need this file.
# For a local-mode build, copy to a NEW .env; preserve any existing .env.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace_me
VITE_DATA_SOURCE=local
VITE_SUPABASE_STRICT=false

# Optional integrations are not configured by this template.
VITE_WALLETCONNECT_PROJECT_ID=
VITE_ENABLE_PVM_CLOSEOUT=0
VITE_SIMULATE_CHAIN=0

# Database integration: use your local CLI's public anon key and select
# VITE_DATA_SOURCE=supabase / VITE_SUPABASE_STRICT=true.
# Never put service-role keys, database passwords or wallet secrets in VITE_ vars.
